  "command": "PYTHONDONTWRITEBYTECODE=1 python3 -c 'import json, shlex, sys\nfrom tests import window_pipeline_parity as w\nrec = w.corpus_record\nCase = w.WindowPipelineCase\nAdvance = w.WindowPipelineAdvance\ndef snap(anchor, difficulties):\n    return tuple(rec(seq, share_difficulty=d, job_issued_at_ms=anchor - 20 + seq, accepted_at_ms=anchor - 10 + seq) for seq, d in enumerate(difficulties, 1))\ndef delta(anchor, first, difficulties):\n    return tuple(rec(seq, share_difficulty=d, job_issued_at_ms=anchor + 1, accepted_at_ms=anchor + 2) for seq, d in enumerate(difficulties, first))\ncases = (\n    Case(name=\"advance-page-expiry-at-weight\", why=\"page_size 2, weight 2, four difficulty-1 records: the snapshot retains the one full page [3,4] at total 2; the advance appends the fresh page [5,6] (total 4) and 4-2 = 2 >= 2 expires the old page wholesale exactly at the weight, touched_pages 0. A whole-page expiry using > instead of >= keeps the page, empties it in the partial loop and counts it touched\", anchor_job_issued_at_ms=300_000, window_weight=2, page_size=2, snapshot_records=snap(300_000, (1, 1, 1, 1)), advances=(Advance(anchor_job_issued_at_ms=300_002, delta_records=delta(300_000, 5, (1, 1))),)),\n    Case(name=\"advance-page-expiry-at-weight-second-page\", why=\"page_size 2, weight 4, six difficulty-1 records: the snapshot retains pages [3,4],[5,6] at total 4; the advance appends [7,8],[9,10] (total 8); 8-2 = 6 expires [3,4] above the weight, then 6-2 = 4 >= 4 expires [5,6] exactly at the weight, retaining [7,8],[9,10] with touched_pages 0. The exact-weight page is the second retained page, so the whole-page loop must keep going after its first expiry\", anchor_job_issued_at_ms=310_000, window_weight=4, page_size=2, snapshot_records=snap(310_000, (1, 1, 1, 1, 1, 1)), advances=(Advance(anchor_job_issued_at_ms=310_002, delta_records=delta(310_000, 7, (1, 1, 1, 1))),)),\n    Case(name=\"advance-page-expiry-one-below-weight\", why=\"page_size 2, weight 3, difficulties (1,1,2,1): the snapshot retains [3,4] at total 3; the advance appends [5,6] of difficulty 1 each (total 5); 5-3 = 2, one below the weight, keeps the old page, and the partial loop expires seq 3 alone (5-2 = 3 >= 3, then 3-1 = 2 < 3), touched_pages 1\", anchor_job_issued_at_ms=320_000, window_weight=3, page_size=2, snapshot_records=snap(320_000, (1, 1, 2, 1)), advances=(Advance(anchor_job_issued_at_ms=320_002, delta_records=delta(320_000, 5, (1, 1))),)),\n    Case(name=\"advance-page-expiry-one-above-weight\", why=\"page_size 2, weight 3, difficulties (1,1,2,1): the snapshot retains [3,4] at total 3; the advance appends [5,6] of difficulty 2 each (total 7); 7-3 = 4, one above the weight, expires the old page wholesale, and the partial loop keeps both new rows (4-2 = 2 < 3), touched_pages 0\", anchor_job_issued_at_ms=330_000, window_weight=3, page_size=2, snapshot_records=snap(330_000, (1, 1, 2, 1)), advances=(Advance(anchor_job_issued_at_ms=330_002, delta_records=delta(330_000, 5, (2, 2))),)),\n)\nadapter = w.PythonWindowPipelineAdapter()\nentries = {case.name: w.reference_case_entry(case, adapter.run(case)) for case in cases}\nrefused = sorted(name for name, entry in entries.items() if \"rejected\" in entry)\nrefused and sys.exit(\"supplementary case rejected by the oracle: \" + \", \".join(refused))\ncommand = \"PYTHONDONTWRITEBYTECODE=1 python3 -c \" + shlex.quote(sys.orig_argv[-1]) + \" > supplementary.json\"\ndocument = {\"schema\": \"qbit-prism-window-pipeline-parity-supplementary/v1\", \"source_commit\": \"504846cc0b72e8f86ed17f896d4ccbbe196a31dc\", \"command\": command, \"cases\": entries}\nsys.stdout.write(json.dumps(document, indent=2, sort_keys=True) + \"\\n\")' > supplementary.json",
