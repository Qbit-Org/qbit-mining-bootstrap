{
  "policies": {
    "ledger": {
      "class": "delegated",
      "owner": "ledger",
      "reason": "Ledger::acquire/::begin records once when metrics are attached; SQL/BEGIN uses that checkout. Operator Ledger instances may have no metrics."
    },
    "timer": {
      "class": "timed",
      "owner": "metrics",
      "reason": "Fresh pool checkout enclosed by time_pool_acquire; success ends before SQL/BEGIN, failure includes pending cancellation."
    },
    "transaction": {
      "class": "borrowed",
      "owner": "ledger",
      "reason": "BEGIN/rollback on an already acquired or detached connection; no additional pool checkout."
    },
    "startup": {
      "class": "startup",
      "owner": "ledger startup/migrations",
      "reason": "Schema, capability, provenance or session-setting gate before serving; intentionally excluded unless already using the timed transaction helper."
    },
    "startup-generic": {
      "class": "startup",
      "owner": "ledger migrations",
      "reason": "Generic Acquire helper: startup passes a pool, migration passes a borrowed connection. Exact callers are also guarded; no run-role work-loop caller."
    },
    "public": {
      "class": "public",
      "owner": "public API",
      "reason": "HTTP reads: public dispatch substitutes its isolated read pool, while private audit endpoints can retain the run pool. These operator/public API requests are explicitly excluded; public-role export policy remains separate."
    },
    "public-hook": {
      "class": "borrowed",
      "owner": "public API",
      "reason": "after_connect/before_acquire hook receives an existing PgConnection; SQL here is not another checkout."
    },
    "operator": {
      "class": "operator",
      "owner": "operator recovery/tools",
      "reason": "Read-only candidate inventory/recovery, fatal-state inspection, or self-check command; no run frontend call."
    },
    "compatibility": {
      "class": "compatibility",
      "owner": "partition/rollup public API",
      "reason": "Pool-only public wrapper has no metrics owner; retained for compatibility. The run frontend calls the metrics-aware entrypoint."
    },
    "partition-lead": {
      "class": "compatibility",
      "owner": "share partitions",
      "reason": "Pool-only public lead_rows utility; no production frontend caller. Metrics collector reads headroom on its existing timed transaction."
    },
    "audit-public": {
      "class": "compatibility",
      "owner": "audit API",
      "reason": "Public pool-only audit wrapper forwards None; production Ledger audit_bundle uses the metrics-aware reader. Connection-backed operator reconstruction borrows."
    },
    "audit-forward": {
      "class": "delegated",
      "owner": "audit ledger",
      "reason": "Forwards the optional metrics owner to AuditReader/verify_durable_range; each fresh checkout is timed at the leaf, borrowed connections add no sample."
    },
    "maintenance-forward": {
      "class": "delegated",
      "owner": "server maintenance",
      "reason": "Server/maintenance loop forwards its metrics owner to the timed checkout leaf; forwarding is not an additional observation."
    },
    "audit-completeness": {
      "class": "operator",
      "owner": "operator audit tools",
      "reason": "Generic Executor audit completeness query: operator import check uses a pool, self-check sample uses a borrowed connection; exact callers are guarded."
    },
    "non-database": {
      "class": "non-database",
      "owner": "runtime",
      "reason": "Lexical name collision with checkout/helper methods: CPU preparation, admission, runtime or command dispatch, rather than a fresh SQLx checkout at this call site."
    }
  },
