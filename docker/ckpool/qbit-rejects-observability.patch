+/* qbit rejects observability: write the cumulative pool and per-worker
+ * submission tallies to logdir/pool/rejects.status once per statsupdate
+ * cycle (60s). The pool tally and every worker tally are copied under one
+ * rejects_lock hold, so each document is a single consistent snapshot and
+ * per-bucket worker sums can never exceed the pool totals. The file is
+ * staged as rejects.status.tmp and renamed into place so exporters never
+ * observe a partial document. */
+static void qbit_write_rejects_status(ckpool_t *ckp, sdata_t *sdata, const time_t runtime)
+{
+	size_t worker_count, worker_limit, workers_snapped = 0, i;
+	char *fname = NULL, *tmpname = NULL, *s;
+	json_t *val, *pool_val, *overflow_val, *workers_val;
+	struct qbit_worker_rejects *rejects;
+	worker_instance_t **workers;
+	qbit_reject_tally_t pool_tally, overflow_tally;
+	qbit_reject_tally_t *tallies;
+	bool workers_truncated;
+	int ret;
+	FILE *fp;
+
+	/* Size from the lock-protected active list, then allocate without
+	 * blocking submissions. New records append at the tail, so copying
+	 * this prefix later cannot displace a worker counted here. */
+	mutex_lock(&sdata->rejects_lock);
+	worker_count = sdata->rejects_worker_count;
+	worker_limit = sdata->rejects_worker_limit;
+	mutex_unlock(&sdata->rejects_lock);
+
+	/* One extra slot so a zero worker count needs no special casing */
+	workers = ckalloc(sizeof(worker_instance_t *) * (worker_count + 1));
+	tallies = ckalloc(sizeof(qbit_reject_tally_t) * (worker_count + 1));
+
+	/* Single lock hold: the pool and the captured active-list prefix form
+	 * one consistent snapshot. Workers whose first event arrived after
+	 * sizing append after this prefix and join the next cycle. */
+	mutex_lock(&sdata->rejects_lock);
+	memcpy(&pool_tally, &sdata->rejects, sizeof(pool_tally));
+	memcpy(&overflow_tally, &sdata->rejects_worker_overflow,
+	       sizeof(overflow_tally));
+	workers_truncated = sdata->rejects_workers_truncated;
+	rejects = sdata->rejects_workers;
+	while (workers_snapped < worker_count && rejects) {
+		workers[workers_snapped] = rejects->worker;
+		memcpy(&tallies[workers_snapped], &rejects->tally,
+		       sizeof(qbit_reject_tally_t));
+		workers_snapped++;
+		rejects = rejects->next;
+	}
+	mutex_unlock(&sdata->rejects_lock);
+
+	val = json_object();
+	json_set_int(val, "version", 1);
+	json_set_string(val, "poolinstance", ckp->name);
+	json_set_int64(val, "runtime", runtime);
+	json_set_int64(val, "lastupdate", time(NULL));
+	json_set_int(val, "interval", 60);
+	json_set_int64(val, "worker_limit", worker_limit);
+	json_set_bool(val, "workers_truncated", workers_truncated);
+
+	pool_val = json_object();
+	qbit_tally_to_json(pool_val, &pool_tally);
+	json_object_set_new_nocheck(val, "pool", pool_val);
+
+	overflow_val = json_object();
+	qbit_tally_to_json(overflow_val, &overflow_tally);
+	json_object_set_new_nocheck(val, "worker_overflow", overflow_val);
+
+	workers_val = json_array();
+	for (i = 0; i < workers_snapped; i++) {
+		json_t *wval = json_object();
+
+		json_set_string(wval, "workername", workers[i]->workername);
+		qbit_tally_to_json(wval, &tallies[i]);
+		json_array_append_new(workers_val, wval);
+	}
+	json_object_set_new_nocheck(val, "workers", workers_val);
+	dealloc(workers);
+	dealloc(tallies);
+
+	s = json_dumps(val, JSON_NO_UTF8 | JSON_PRESERVE_ORDER | JSON_EOL |
+		       JSON_REAL_PRECISION(16));
+	json_decref(val);
+	if (unlikely(!s)) {
+		LOGERR("Failed to dump rejects status json");
+		return;
+	}
+
+	ASPRINTF(&fname, "%s/pool/rejects.status", ckp->logdir);
+	ASPRINTF(&tmpname, "%s.tmp", fname);
+	fp = fopen(tmpname, "we");
+	if (unlikely(!fp)) {
+		LOGERR("Failed to fopen %s", tmpname);
+		goto out;
+	}
+	ret = fprintf(fp, "%s", s);
+	if (unlikely(fclose(fp) || ret < 0)) {
+		LOGERR("Failed to write %s", tmpname);
+		unlink(tmpname);
+		goto out;
+	}
+	if (unlikely(rename(tmpname, fname)))
+		LOGERR("Failed to rename %s to %s", tmpname, fname);
+out:
+	dealloc(s);
+	dealloc(tmpname);
+	dealloc(fname);
+}
