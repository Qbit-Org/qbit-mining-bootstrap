 typedef struct pool_stats pool_stats_t;
 
+/* qbit rejects observability: submission tallies aggregated by reason.
+ * Counters are cumulative since stratifier startup so exporters can derive
+ * rates from deltas. accepted lands in its own bucket; every reject reason
+ * maps to exactly one other bucket, so bucket sums equal total submissions. */
+enum qbit_submit_reason {
+	QR_ACCEPTED = 0,
+	QR_ABOVE_TARGET,	/* SE_HIGH_DIFF: hash above target for assigned diff */
+	QR_STALE,		/* SE_STALE */
+	QR_DUPLICATE,		/* SE_DUPE */
+	QR_INVALID_JOB,		/* SE_INVALID_JOBID */
+	QR_INVALID_NTIME,	/* SE_NTIME_INVALID */
+	QR_INVALID_VERSION,	/* SE_INVALID_VERSION_MASK */
+	QR_MALFORMED,		/* Any other unprocessable submission */
+	QR_REASONS
+};
+
+/* Outcome of local submitblock for block-candidate shares, tracked
+ * independently of the share reason buckets above since a candidate can
+ * additionally be accepted, stale or duplicate as a share. */
+enum qbit_block_outcome {
+	QB_ACCEPTED = 0,
+	QB_REJECTED,
+	QB_OUTCOMES
+};
+
+/* All tallies are guarded by sdata->rejects_lock on the pool sdata,
+ * including the lazily allocated per-worker records. */
+struct qbit_reject_tally {
+	int64_t count[QR_REASONS];
+	double diff[QR_REASONS];	/* Sum of assigned difficulty */
+	int64_t block_count[QB_OUTCOMES];
+	double block_diff[QB_OUTCOMES];	/* Sum of block-candidate share difficulty */
+};
+
+typedef struct qbit_reject_tally qbit_reject_tally_t;
+
+#define QBIT_REJECTS_WORKER_LIMIT_MAX 4096
+
+static const char *qbit_reason_names[QR_REASONS] = {
+	"accepted",
+	"above_target",
+	"stale",
+	"duplicate",
+	"invalid_job",
+	"invalid_ntime",
+	"invalid_version",
+	"malformed"
+};
+
+static const char *qbit_block_outcome_names[QB_OUTCOMES] = {
+	"block_accepted",
+	"block_rejected"
+};
+
+/* Keep the production bound compile-time enforced. An operator may lower it
+ * for a constrained deployment (and the live suite does so to exercise the
+ * overflow path), but environment configuration can never remove the cap. */
+static size_t qbit_rejects_worker_limit(void)
+{
+	const char *setting = getenv("QBIT_REJECTS_WORKER_LIMIT");
+	unsigned long configured;
+	char *end;
+
+	if (!setting || !*setting)
+		return QBIT_REJECTS_WORKER_LIMIT_MAX;
+
+	errno = 0;
+	configured = strtoul(setting, &end, 10);
+	if (errno || end == setting || *end || !configured ||
+	    configured > QBIT_REJECTS_WORKER_LIMIT_MAX) {
+		LOGWARNING("Ignoring invalid QBIT_REJECTS_WORKER_LIMIT=%s (valid range 1-%d)",
+			   setting, QBIT_REJECTS_WORKER_LIMIT_MAX);
+		return QBIT_REJECTS_WORKER_LIMIT_MAX;
+	}
+
+	return configured;
+}
