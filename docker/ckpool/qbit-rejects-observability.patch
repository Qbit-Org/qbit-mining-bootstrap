+/* qbit rejects observability: render one tally as json entries of the form
+ * "reason": {"count": N, "diff": D} appended to val. */
+static void qbit_tally_to_json(json_t *val, const qbit_reject_tally_t *tally)
+{
+	json_t *entry;
+	int i;
+
+	for (i = 0; i < QR_REASONS; i++) {
+		JSON_CPACK(entry, "{sI,sf}", "count", tally->count[i],
+			   "diff", tally->diff[i]);
+		json_object_set_new_nocheck(val, qbit_reason_names[i], entry);
+	}
+	for (i = 0; i < QB_OUTCOMES; i++) {
+		JSON_CPACK(entry, "{sI,sf}", "count", tally->block_count[i],
+			   "diff", tally->block_diff[i]);
+		json_object_set_new_nocheck(val, qbit_block_outcome_names[i], entry);
+	}
+}
