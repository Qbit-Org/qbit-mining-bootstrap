+/* Entered with rejects_lock held. Register a worker on its first counted
+ * event and append it at the tail so a writer that sized an earlier prefix
+ * cannot have an existing worker displaced by a concurrent first submit.
+ * Return NULL at the hard limit; those events go to the bounded overflow
+ * aggregate rather than growing memory or periodic snapshot work. */
+static struct qbit_worker_rejects *
+qbit_get_worker_rejects(sdata_t *sdata, worker_instance_t *worker)
+{
+	struct qbit_worker_rejects *rejects = worker->rejects;
+
+	if (unlikely(!rejects)) {
+		if (unlikely(sdata->rejects_worker_count >= sdata->rejects_worker_limit)) {
+			sdata->rejects_workers_truncated = true;
+			return NULL;
+		}
+		rejects = ckzalloc(sizeof(*rejects));
+		rejects->worker = worker;
+		worker->rejects = rejects;
+		if (sdata->rejects_workers_tail)
+			sdata->rejects_workers_tail->next = rejects;
+		else
+			sdata->rejects_workers = rejects;
+		sdata->rejects_workers_tail = rejects;
+		sdata->rejects_worker_count++;
+	}
+
+	return rejects;
+}
