+/* qbit rejects observability: map the outcome of one mining.submit to a
+ * reason bucket. err alone is not enough since accepted shares leave err at
+ * SE_NONE with result true; a false result with SE_NONE means the share was
+ * dropped before classification and lands in the malformed bucket. */
+static enum qbit_submit_reason qbit_classify_submit(const enum share_err err, const bool result)
+{
+	if (result)
+		return QR_ACCEPTED;
+	switch (err) {
+		case SE_HIGH_DIFF:
+			return QR_ABOVE_TARGET;
+		case SE_STALE:
+			return QR_STALE;
+		case SE_DUPE:
+			return QR_DUPLICATE;
+		case SE_INVALID_JOBID:
+			return QR_INVALID_JOB;
+		case SE_NTIME_INVALID:
+			return QR_INVALID_NTIME;
+		case SE_INVALID_VERSION_MASK:
+			return QR_INVALID_VERSION;
+		default:
+			return QR_MALFORMED;
+	}
+}
+
+/* qbit rejects observability: account one submission and its assigned diff
+ * to the pool tally and the submitting worker's tally. Purely observational;
+ * never alters share validation state or the client response. */
+static void qbit_record_submit(ckpool_t *ckp, worker_instance_t *worker,
+			       const enum qbit_submit_reason reason, const double diff)
+{
+	sdata_t *sdata = ckp->sdata;
+
+	mutex_lock(&sdata->rejects_lock);
+	sdata->rejects.count[reason]++;
+	sdata->rejects.diff[reason] += diff;
+	if (likely(worker)) {
+		worker->rejects.count[reason]++;
+		worker->rejects.diff[reason] += diff;
+	}
+	mutex_unlock(&sdata->rejects_lock);
+}
