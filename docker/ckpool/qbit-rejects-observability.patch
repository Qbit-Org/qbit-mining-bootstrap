+/* qbit rejects observability: account a local submitblock outcome for a
+ * block-candidate share to the pool tally and, when the candidate carries a
+ * workername, to that worker's tally. Purely observational; never alters
+ * block submission behaviour. */
+static void qbit_record_block_outcome(ckpool_t *ckp, const char *workername,
+				      const enum qbit_block_outcome outcome, const double diff)
+{
+	sdata_t *sdata = ckp->sdata;
+	worker_instance_t *worker = NULL;
+
+	if (workername) {
+		user_instance_t *user = user_by_workername(sdata, workername);
+
+		worker = get_worker(sdata, user, workername);
+	}
+
+	mutex_lock(&sdata->rejects_lock);
+	sdata->rejects.block_count[outcome]++;
+	sdata->rejects.block_diff[outcome] += diff;
+	if (worker) {
+		worker->rejects.block_count[outcome]++;
+		worker->rejects.block_diff[outcome] += diff;
+	}
+	mutex_unlock(&sdata->rejects_lock);
+}
