{
  "schema": "qbit.prism.load-preset.v1",
  "name": "soak-smoke",
  "description": "The soak smoke (#575), run nightly by the opt-in gated test soak_smoke: the pr-smoke cluster (one debug frontend, 100 sessions over 20 addresses) with a 1,000-share window, looping pr-smoke's workload for four cycles in one server lifetime, rolling the share ledger over twice and archiving and dropping two partitions, sampled every 5 s. Its memory and descriptor bounds are loose, since four minutes of a debug server is not a trend; it proves the machinery, and soak-short and soak-weekly hold the trends.",
  "issues": [
    "#575"
  ],
  "schedule": "manual",
  "runner": "blacksmith-2vcpu-ubuntu-2404",
  "timeout_minutes": 15,
  "gates": {
    "phases": null,
    "max_shortfall": 0,
    "max_rejected_valid_shares": null,
    "max_unanswered_submits": null,
    "tip_last_notify_p99_budget_ms": 5000,
    "d1_verdict_table": false,
    "churn_tip_last_notify_p99_budget_ms": 5000,
    "new_session_first_job_p99_budget_ms": 5000
  },
  "args": {
    "--ack-p99-limit-ms": 1000,
    "--arrival": "bursty:cv1=0.5,cv60=0.5,max=4",
    "--background-shares-per-second": 20,
    "--blockpoll-seconds": 2,
    "--burst-rate": null,
    "--burst-seconds": null,
    "--cadence": "none",
    "--cadence-gaps": "9,19,9,18,20",
    "--cadence-rate": 20,
    "--cadence-seconds": 240,
    "--churn-rate": 20,
    "--churn-seconds": 30,
    "--churn-tips": 2,
    "--ctv-settlement": false,
    "--database-url": null,
    "--db-max-connections": 16,
    "--external-tips": 3,
    "--faults": null,
    "--forecast-peak-shares-per-second": 2000,
    "--frontends": 1,
    "--lock-sample-interval-ms": 10,
    "--max-outstanding-per-session": 1,
    "--mid-flight-kill": false,
    "--min-mem-available-mib": 1024,
    "--node": "fake",
    "--plan": "soak",
    "--pool-fee-bps": 0,
    "--process-sample-interval-ms": 1000,
    "--rate": 20,
    "--recipient-weights": "whale:0.6+zipf:1.1",
    "--recipients": 20,
    "--reconnect-seconds": 60,
    "--reconnect-storms": "0.3",
    "--reconnect-target": 12,
    "--rental-burst-interval-seconds": 10,
    "--rental-burst-window-seconds": 4,
    "--rental-bursts": "20,40",
    "--rental-hashrate": 5,
    "--rental-lifetime": "pareto:xm=5,alpha=1.2,max=60",
    "--replication": "none",
    "--retarget-bits": true,
    "--runtime-workers": 2,
    "--scheduled-blocks": 0,
    "--seed": 1,
    "--seed-share-bytes": 581,
    "--session-difficulty": "vardiff:100",
    "--session-hashrate-sigma": 0.5,
    "--sessions": 100,
    "--share-commit-timeout-seconds": 15,
    "--slow-database-seconds": 60,
    "--slow-db-delay-ms": 10,
    "--steady-state-rate": 20,
    "--steady-state-seconds": 60,
    "--storm-interval-seconds": 20,
    "--storm-reconnect-seconds": 3,
    "--stratum-max-pending-initial-jobs": 128,
    "--template-bits": "1e7fffff",
    "--warmup-seconds": 24,
    "--window-shares": 1000,
    "--work-timeout": 120
  },
  "soak": {
    "minutes": 4,
    "presets": [
      "pr-smoke"
    ],
    "sample_seconds": 5,
    "rollover_minutes": [
      0.2,
      0.8
    ],
    "rollover_margin_rows": 200,
    "archive_every_minutes": 0.2,
    "archive_window_multiple": 1,
    "archive_retention_days": 0,
    "partition_ensure_interval_seconds": 2,
    "gates": {
      "warmup_minutes": 0.5,
      "min_gated_samples": 10,
      "rss_slope_mib_per_hour_max": 4096,
      "rss_trend_window_minutes": 0.7,
      "min_trend_windows": 3,
      "rss_warmup_peak_multiple_max": null,
      "rss_expected_failure": null,
      "fd_slope_per_hour_max": 4000,
      "pool_connections_max": 24,
      "pool_connections_drift_max": 8,
      "wal_bytes_max": 1073741824,
      "min_rollovers": 2,
      "min_archive_cycles": 2,
      "one_lifetime": true
    }
  }
}
