{
  "schema": "qbit.prism.load-preset.v1",
  "name": "short-plan-fake-node",
  "description": "The short plan on the fake node, the bridging pair's fake half (#547, #552): 2 frontends, 100 sessions, a 20k window at 50 shares/s (an own block implied every 50 s), 3 external tips, 1 scheduled own block, an async standby. Identical to short-plan-real-node except --node, so the difference between the two is what the real node costs.",
  "issues": [
    "#547",
    "#552"
  ],
  "schedule": "nightly",
  "runner": "blacksmith-8vcpu-ubuntu-2404",
  "timeout_minutes": 30,
  "gates": {
    "phases": [
      "warm_up",
      "steady_state",
      "reconnect"
    ],
    "max_shortfall": 0,
    "max_rejected_valid_shares": null,
    "max_unanswered_submits": null,
    "tip_last_notify_p99_budget_ms": 5000,
    "d1_verdict_table": false,
    "churn_tip_last_notify_p99_budget_ms": null,
    "new_session_first_job_p99_budget_ms": null
  },
  "args": {
    "--ack-p99-limit-ms": 1000,
    "--arrival": "smooth",
    "--background-shares-per-second": 50,
    "--blockpoll-seconds": 2,
    "--burst-rate": null,
    "--burst-seconds": null,
    "--cadence": "none",
    "--cadence-gaps": "9,19,9,18,20",
    "--cadence-rate": 50,
    "--cadence-seconds": 240,
    "--churn-rate": 50,
    "--churn-seconds": 0,
    "--churn-tips": 0,
    "--ctv-settlement": false,
    "--database-url": null,
    "--db-max-connections": 16,
    "--external-tips": 3,
    "--faults": null,
    "--forecast-peak-shares-per-second": 2000,
    "--frontends": 2,
    "--lock-sample-interval-ms": 10,
    "--max-outstanding-per-session": 1,
    "--mid-flight-kill": false,
    "--min-mem-available-mib": 4096,
    "--node": "fake",
    "--plan": "short",
    "--pool-fee-bps": 0,
    "--process-sample-interval-ms": 1000,
    "--rate": 50,
    "--recipient-weights": "uniform",
    "--recipients": null,
    "--reconnect-seconds": 60,
    "--reconnect-storms": "none",
    "--reconnect-target": 12,
    "--rental-burst-interval-seconds": 10,
    "--rental-burst-window-seconds": 4,
    "--rental-bursts": "none",
    "--rental-hashrate": 5,
    "--rental-lifetime": "pareto:xm=5,alpha=1.2,max=60",
    "--replication": "async",
    "--retarget-bits": false,
    "--runtime-workers": 2,
    "--scheduled-blocks": 1,
    "--seed": 1,
    "--seed-share-bytes": 581,
    "--session-difficulty": "fixed",
    "--session-hashrate-sigma": 0.0,
    "--sessions": 100,
    "--share-commit-timeout-seconds": 15,
    "--slow-database-seconds": 60,
    "--slow-db-delay-ms": 10,
    "--steady-state-rate": 50,
    "--steady-state-seconds": 60,
    "--storm-interval-seconds": 20,
    "--storm-reconnect-seconds": 3,
    "--stratum-max-pending-initial-jobs": 128,
    "--template-bits": "1e7fffff",
    "--warmup-seconds": 30,
    "--window-shares": 20000,
    "--work-timeout": 120
  }
}
