{
  "schema": "qbit.prism.load-preset.v1",
  "name": "faults-short-real-node",
  "description": "The nightly fault set under load (#554, #487 S16 and L4's short set): a managed regtest qbitd pair ramped to the fake node's difficulty, two frontends with an async standby, 500 sessions at 50 shares/s over a 20k window, then a faults phase that injects, one at a time with a 10 s baseline and a 20 s recovery window: a 20 ms one-way database delay and a PostgreSQL at max_connections (30 s each), a 30 s SETTLEMENT_LOCK holder with a tip minted halfway, SIGKILL of the frontend holding a found block the node accepted, SIGTERM of a frontend with a found block's offer in flight, a rolling restart of both frontends and a 50% reconnect storm, while the public API and every /metrics are scraped. Each fault is held to its #554 pass criteria.",
  "issues": [
    "#554",
    "#487"
  ],
  "schedule": "nightly",
  "runner": "blacksmith-8vcpu-ubuntu-2404",
  "timeout_minutes": 45,
  "gates": {
    "phases": [
      "warm_up"
    ],
    "max_shortfall": 0,
    "max_rejected_valid_shares": null,
    "max_unanswered_submits": null,
    "tip_last_notify_p99_budget_ms": 5000,
    "d1_verdict_table": false,
    "churn_tip_last_notify_p99_budget_ms": null,
    "new_session_first_job_p99_budget_ms": null
  },
  "args": {
    "--ack-p99-limit-ms": 1000,
    "--arrival": "smooth",
    "--background-shares-per-second": 50,
    "--blockpoll-seconds": 2,
    "--burst-rate": null,
    "--burst-seconds": null,
    "--cadence": "none",
    "--cadence-gaps": "9,19,9,18,20",
    "--cadence-rate": 50,
    "--cadence-seconds": 240,
    "--churn-rate": 50,
    "--churn-seconds": 0,
    "--churn-tips": 0,
    "--database-url": null,
    "--db-max-connections": 16,
    "--external-tips": 2,
    "--faults": "slow-database,pool-exhaustion,settlement-lock,frontend-sigkill,sigterm-drain,rolling-restart,reconnect-storm;baseline=10;hold=30;recovery=20;storm=0.5;lease-wait=180",
    "--forecast-peak-shares-per-second": 2000,
    "--frontends": 2,
    "--lock-sample-interval-ms": 10,
    "--max-outstanding-per-session": 1,
    "--mid-flight-kill": false,
    "--min-mem-available-mib": 4096,
    "--node": "qbitd",
    "--plan": "tips",
    "--pool-fee-bps": 0,
    "--process-sample-interval-ms": 1000,
    "--rate": 50,
    "--recipient-weights": "uniform",
    "--recipients": null,
    "--reconnect-seconds": 60,
    "--reconnect-storms": "none",
    "--reconnect-target": 12,
    "--rental-burst-interval-seconds": 10,
    "--rental-burst-window-seconds": 4,
    "--rental-bursts": "none",
    "--rental-hashrate": 5,
    "--rental-lifetime": "pareto:xm=5,alpha=1.2,max=60",
    "--replication": "async",
    "--retarget-bits": false,
    "--runtime-workers": 2,
    "--scheduled-blocks": 0,
    "--seed": 1,
    "--seed-share-bytes": 581,
    "--session-difficulty": "fixed",
    "--session-hashrate-sigma": 0.0,
    "--sessions": 500,
    "--share-commit-timeout-seconds": 15,
    "--slow-database-seconds": 60,
    "--slow-db-delay-ms": 20,
    "--steady-state-rate": 50,
    "--steady-state-seconds": 60,
    "--storm-interval-seconds": 20,
    "--storm-reconnect-seconds": 3,
    "--stratum-max-pending-initial-jobs": 128,
    "--template-bits": "1e7fffff",
    "--warmup-seconds": 30,
    "--window-shares": 20000,
    "--work-timeout": 120
  }
}
