{
  "schema": "qbit.prism.load-preset.v1",
  "name": "faults-failover-fake-node",
  "description": "The database and landing faults under load on the fake node, for dispatch (#554): two debug-or-release frontends, an async standby streaming through a link the harness can cut, 100 sessions over a 20k window, then a faults phase with, one at a time: the primary's WAL volume filled until PostgreSQL stops and then freed, both frontends restarted over a backlog of three found blocks the node refused while warming up, the primary lost after a 3 s replication cut with the standby promoted, the fenced planned switch, and a found block's submitblock held across a failover. Each fault is held to its #554 pass criteria. The nightly real-node preset runs the same faults but the WAL volume.",
  "issues": [
    "#554"
  ],
  "schedule": "manual",
  "runner": "blacksmith-8vcpu-ubuntu-2404",
  "timeout_minutes": 30,
  "gates": {
    "phases": [
      "warm_up"
    ],
    "max_shortfall": 0,
    "max_rejected_valid_shares": null,
    "max_unanswered_submits": null,
    "tip_last_notify_p99_budget_ms": 5000,
    "d1_verdict_table": false,
    "churn_tip_last_notify_p99_budget_ms": null,
    "new_session_first_job_p99_budget_ms": null
  },
  "args": {
    "--ack-p99-limit-ms": 1000,
    "--arrival": "smooth",
    "--background-shares-per-second": 20,
    "--blockpoll-seconds": 2,
    "--burst-rate": null,
    "--burst-seconds": null,
    "--cadence": "none",
    "--cadence-gaps": "9,19,9,18,20",
    "--cadence-rate": 20,
    "--cadence-seconds": 240,
    "--churn-rate": 20,
    "--churn-seconds": 0,
    "--churn-tips": 0,
    "--ctv-settlement": false,
    "--database-url": null,
    "--db-max-connections": 16,
    "--external-tips": 1,
    "--faults": "wal-disk-full,candidate-backlog,primary-kill,primary-switch,block-failover;baseline=5;hold=25;recovery=10;cut=3;backlog=3",
    "--forecast-peak-shares-per-second": 2000,
    "--frontends": 2,
    "--lock-sample-interval-ms": 10,
    "--max-outstanding-per-session": 1,
    "--mid-flight-kill": false,
    "--min-mem-available-mib": 2048,
    "--node": "fake",
    "--plan": "tips",
    "--pool-fee-bps": 0,
    "--process-sample-interval-ms": 1000,
    "--rate": 20,
    "--recipient-weights": "uniform",
    "--recipients": null,
    "--reconnect-seconds": 60,
    "--reconnect-storms": "none",
    "--reconnect-target": 12,
    "--rental-burst-interval-seconds": 10,
    "--rental-burst-window-seconds": 4,
    "--rental-bursts": "none",
    "--rental-hashrate": 5,
    "--rental-lifetime": "pareto:xm=5,alpha=1.2,max=60",
    "--replication": "async",
    "--retarget-bits": false,
    "--runtime-workers": 2,
    "--scheduled-blocks": 0,
    "--seed": 1,
    "--seed-share-bytes": 581,
    "--session-difficulty": "fixed",
    "--session-hashrate-sigma": 0.0,
    "--sessions": 100,
    "--share-commit-timeout-seconds": 15,
    "--slow-database-seconds": 60,
    "--slow-db-delay-ms": 10,
    "--steady-state-rate": 20,
    "--steady-state-seconds": 60,
    "--storm-interval-seconds": 20,
    "--storm-reconnect-seconds": 3,
    "--stratum-max-pending-initial-jobs": 128,
    "--template-bits": "1e7fffff",
    "--warmup-seconds": 10,
    "--window-shares": 20000,
    "--work-timeout": 120
  }
}
