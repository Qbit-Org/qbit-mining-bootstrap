{
  "schema": "qbit.prism.load-preset.v1",
  "name": "rental-churn-bursts-and-storms",
  "description": "Rental churn over the mainnet-shape-130-addresses population: a warm-up with 2 tips, then 300 s of churn with rental bursts of 100, 500 and 2,000 sessions (each within 10 s, 20x a mean session's hashrate, leaving abruptly after a Pareto(1.2) lifetime from 30 s) and reconnect storms dropping 10%, 25% and 50% of the connected sessions (back within 5 s), with 8 retargeting tips.",
  "issues": [
    "#521"
  ],
  "schedule": "nightly",
  "runner": "blacksmith-8vcpu-ubuntu-2404",
  "timeout_minutes": 60,
  "gates": {
    "phases": [
      "warm_up",
      "churn"
    ],
    "max_shortfall": 0,
    "max_rejected_valid_shares": null,
    "max_unanswered_submits": null,
    "tip_last_notify_p99_budget_ms": 3000,
    "d1_verdict_table": false,
    "churn_tip_last_notify_p99_budget_ms": 3000,
    "new_session_first_job_p99_budget_ms": 10000
  },
  "args": {
    "--ack-p99-limit-ms": 1000,
    "--arrival": "bursty:cv1=0.6,cv60=0.9,max=8",
    "--background-shares-per-second": 50,
    "--blockpoll-seconds": 2,
    "--burst-rate": null,
    "--burst-seconds": null,
    "--cadence": "none",
    "--cadence-gaps": "9,19,9,18,20",
    "--cadence-rate": 50,
    "--cadence-seconds": 240,
    "--churn-rate": 50,
    "--churn-seconds": 300,
    "--churn-tips": 8,
    "--ctv-settlement": false,
    "--database-url": null,
    "--db-max-connections": 16,
    "--external-tips": 2,
    "--faults": null,
    "--forecast-peak-shares-per-second": 400,
    "--frontends": 2,
    "--lock-sample-interval-ms": 10,
    "--max-outstanding-per-session": 1,
    "--mid-flight-kill": false,
    "--min-mem-available-mib": 6144,
    "--node": "fake",
    "--plan": "tips",
    "--pool-fee-bps": 200,
    "--process-sample-interval-ms": 1000,
    "--rate": 50,
    "--recipient-weights": "whale:0.85+zipf:1.1",
    "--recipients": 130,
    "--reconnect-seconds": 60,
    "--reconnect-storms": "0.1,0.25,0.5",
    "--reconnect-target": 12,
    "--rental-burst-interval-seconds": 90,
    "--rental-burst-window-seconds": 10,
    "--rental-bursts": "100,500,2000",
    "--rental-hashrate": 20,
    "--rental-lifetime": "pareto:xm=30,alpha=1.2,max=600",
    "--replication": "async",
    "--retarget-bits": true,
    "--runtime-workers": 4,
    "--scheduled-blocks": 0,
    "--seed": 1,
    "--seed-share-bytes": 581,
    "--session-difficulty": "vardiff:1000",
    "--session-hashrate-sigma": 1,
    "--sessions": 400,
    "--share-commit-timeout-seconds": 15,
    "--slow-database-seconds": 60,
    "--slow-db-delay-ms": 10,
    "--steady-state-rate": 50,
    "--steady-state-seconds": 300,
    "--storm-interval-seconds": 90,
    "--storm-reconnect-seconds": 5,
    "--stratum-max-pending-initial-jobs": 128,
    "--template-bits": "1d3fffff",
    "--warmup-seconds": 60,
    "--window-shares": 400000,
    "--work-timeout": 120
  }
}
