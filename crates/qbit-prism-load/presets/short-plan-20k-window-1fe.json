    "new_session_first_job_p99_budget_ms": null
  },
  "args": {
    "--ack-p99-limit-ms": 1000,
    "--arrival": "smooth",
    "--background-shares-per-second": 50,
    "--blockpoll-seconds": 2,
    "--burst-rate": null,
    "--burst-seconds": null,
    "--cadence": "none",
    "--cadence-gaps": "9,19,9,18,20",
    "--cadence-rate": 50,
    "--cadence-seconds": 240,
    "--churn-rate": 50,
    "--churn-seconds": 0,
    "--churn-tips": 0,
    "--database-url": null,
    "--db-max-connections": 16,
