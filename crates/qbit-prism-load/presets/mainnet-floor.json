{
  "schema": "qbit.prism.load-preset.v1",
  "name": "mainnet-floor",
  "description": "The mainnet 2.x.x shape as a floor: 130 payout addresses, one whale at 85% of the work over a Zipf(1.1) tail, session difficulty over three orders of magnitude, bursty arrivals (1 s CV about 1.2) peaking at 400 shares/s around a 50/s mean, a 400k window, 6 retargeting tips, and mainnet's 200 bps pool fee.",
  "issues": [
    "#521"
  ],
  "schedule": "nightly",
  "runner": "blacksmith-8vcpu-ubuntu-2404",
  "timeout_minutes": 60,
  "gates": {
    "phases": [
      "warm_up",
      "steady_state",
      "reconnect"
    ],
    "max_shortfall": 0,
    "max_rejected_valid_shares": null,
    "max_unanswered_submits": null,
    "tip_last_notify_p99_budget_ms": 3000,
    "d1_verdict_table": false
  },
  "args": {
    "--ack-p99-limit-ms": 1000,
    "--arrival": "bursty:cv1=0.6,cv60=0.9,max=8",
    "--background-shares-per-second": 50,
    "--blockpoll-seconds": 2,
    "--burst-rate": null,
    "--burst-seconds": null,
    "--cadence": "none",
    "--cadence-gaps": "9,19,9,18,20",
    "--cadence-rate": 50,
    "--cadence-seconds": 240,
    "--database-url": null,
    "--db-max-connections": 16,
    "--external-tips": 6,
    "--forecast-peak-shares-per-second": 400,
    "--frontends": 2,
    "--lock-sample-interval-ms": 10,
    "--max-outstanding-per-session": 1,
    "--mid-flight-kill": false,
    "--min-mem-available-mib": 6144,
    "--plan": "short",
    "--pool-fee-bps": 200,
    "--process-sample-interval-ms": 1000,
    "--rate": 50,
    "--recipient-weights": "whale:0.85+zipf:1.1",
    "--recipients": 130,
    "--reconnect-seconds": 60,
    "--reconnect-target": 12,
    "--replication": "async",
    "--retarget-bits": true,
    "--runtime-workers": 4,
    "--scheduled-blocks": 2,
    "--seed": 1,
    "--seed-share-bytes": 581,
    "--session-difficulty": "vardiff:1000",
    "--session-hashrate-sigma": 1,
    "--sessions": 400,
    "--share-commit-timeout-seconds": 15,
    "--slow-database-seconds": 60,
    "--slow-db-delay-ms": 10,
    "--steady-state-rate": 50,
    "--steady-state-seconds": 300,
    "--stratum-max-pending-initial-jobs": 128,
    "--template-bits": "1d3fffff",
    "--warmup-seconds": 240,
    "--window-shares": 400000,
    "--work-timeout": 120
  }
}
