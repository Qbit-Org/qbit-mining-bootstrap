{
  "schema": "qbit.prism.load-preset.v1",
  "name": "smoke",
  "description": "The per-PR smoke run: one debug frontend, 100 sessions over 20 skewed payout addresses, a 20k window and 3 retargeting tips in a tips-only plan.",
  "issues": [
    "#521"
  ],
  "schedule": "smoke",
  "runner": "blacksmith-2vcpu-ubuntu-2404",
  "timeout_minutes": 15,
  "gates": {
    "phases": null,
    "max_shortfall": 0,
    "max_rejected_valid_shares": null,
    "max_unanswered_submits": null,
    "tip_last_notify_p99_budget_ms": 5000,
    "d1_verdict_table": false
  },
  "args": {
    "--ack-p99-limit-ms": 1000,
    "--arrival": "bursty:cv1=0.5,cv60=0.5,max=4",
    "--background-shares-per-second": 20,
    "--blockpoll-seconds": 2,
    "--burst-rate": null,
    "--burst-seconds": null,
    "--cadence": "none",
    "--cadence-gaps": "9,19,9,18,20",
    "--cadence-rate": 20,
    "--cadence-seconds": 240,
    "--database-url": null,
    "--db-max-connections": 16,
    "--external-tips": 3,
    "--forecast-peak-shares-per-second": 2000,
    "--frontends": 1,
    "--lock-sample-interval-ms": 10,
    "--max-outstanding-per-session": 1,
    "--mid-flight-kill": false,
    "--min-mem-available-mib": 1024,
    "--plan": "tips",
    "--pool-fee-bps": 0,
    "--process-sample-interval-ms": 1000,
    "--rate": 20,
    "--recipient-weights": "whale:0.6+zipf:1.1",
    "--recipients": 20,
    "--reconnect-seconds": 60,
    "--reconnect-target": 12,
    "--replication": "none",
    "--retarget-bits": true,
    "--runtime-workers": 2,
    "--scheduled-blocks": 0,
    "--seed": 1,
    "--seed-share-bytes": 581,
    "--session-difficulty": "vardiff:100",
    "--session-hashrate-sigma": 0.5,
    "--sessions": 100,
    "--share-commit-timeout-seconds": 15,
    "--slow-database-seconds": 60,
    "--slow-db-delay-ms": 10,
    "--steady-state-rate": 20,
    "--steady-state-seconds": 60,
    "--stratum-max-pending-initial-jobs": 128,
    "--template-bits": "1e7fffff",
    "--warmup-seconds": 24,
    "--window-shares": 20000,
    "--work-timeout": 120
  }
}
