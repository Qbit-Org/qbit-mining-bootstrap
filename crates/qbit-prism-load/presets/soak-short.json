{
  "schema": "qbit.prism.load-preset.v1",
  "name": "soak-short",
  "description": "A 25 min soak on the soak-weekly cluster, looping the tip-delivery-2000-miners-400k-2fe-retarget workload twice (19 min: 133 shares/s, 16 retargeting tips, no block landing, whose audit builds would step the resident set by hundreds of MiB), with one forced rollover at 8 min and retention passes every 4 min that seal, archive and verify the 400k-window partition under the load: the quick manual soak, and the run a leak must fail (#575). A server built with the soak-leak-mutant feature keeps 16 KiB per accepted share (about 3.7 GiB/h per frontend at this rate) and fails the resident-memory gate here. The bound, 1.5 GiB/h over 3 min window peaks after a 3 min warm-up, sits above a healthy server's first-20-minute growth (cache warm-up, about 0.6 to 0.9 GiB/h) and so only catches a gross leak; soak-weekly's 16 MiB/h after an hour is the sensitive one.",
  "issues": [
    "#575"
  ],
  "schedule": "manual",
  "runner": "blacksmith-8vcpu-ubuntu-2404",
  "timeout_minutes": 60,
  "gates": {
    "phases": null,
    "max_shortfall": 0,
    "max_rejected_valid_shares": null,
    "max_unanswered_submits": null,
    "tip_last_notify_p99_budget_ms": 2500,
    "d1_verdict_table": false,
    "churn_tip_last_notify_p99_budget_ms": null,
    "new_session_first_job_p99_budget_ms": null
  },
  "args": {
    "--ack-p99-limit-ms": 1000,
    "--arrival": "bursty:cv1=0.6,cv60=0.9,max=8",
    "--background-shares-per-second": 50,
    "--blockpoll-seconds": 2,
    "--burst-rate": null,
    "--burst-seconds": null,
    "--cadence": "none",
    "--cadence-gaps": "9,19,9,18,20",
    "--cadence-rate": 50,
    "--cadence-seconds": 240,
    "--churn-rate": 50,
    "--churn-seconds": 300,
    "--churn-tips": 8,
    "--ctv-settlement": false,
    "--database-url": null,
    "--db-max-connections": 16,
    "--external-tips": 6,
    "--faults": null,
    "--forecast-peak-shares-per-second": 400,
    "--frontends": 2,
    "--lock-sample-interval-ms": 1000,
    "--max-outstanding-per-session": 1,
    "--mid-flight-kill": false,
    "--min-mem-available-mib": 6144,
    "--node": "fake",
    "--plan": "soak",
    "--pool-fee-bps": 200,
    "--process-sample-interval-ms": 1000,
    "--rate": 50,
    "--recipient-weights": "whale:0.85+zipf:1.1",
    "--recipients": 130,
    "--reconnect-seconds": 60,
    "--reconnect-storms": "0.1,0.25,0.5",
    "--reconnect-target": 12,
    "--rental-burst-interval-seconds": 90,
    "--rental-burst-window-seconds": 10,
    "--rental-bursts": "100,500,2000",
    "--rental-hashrate": 20,
    "--rental-lifetime": "pareto:xm=30,alpha=1.2,max=600",
    "--replication": "async",
    "--retarget-bits": true,
    "--runtime-workers": 4,
    "--scheduled-blocks": 2,
    "--seed": 1,
    "--seed-share-bytes": 581,
    "--session-difficulty": "vardiff:1000",
    "--session-hashrate-sigma": 1,
    "--sessions": 400,
    "--share-commit-timeout-seconds": 15,
    "--slow-database-seconds": 60,
    "--slow-db-delay-ms": 10,
    "--steady-state-rate": 50,
    "--steady-state-seconds": 300,
    "--storm-interval-seconds": 90,
    "--storm-reconnect-seconds": 5,
    "--stratum-max-pending-initial-jobs": 128,
    "--template-bits": "1d3fffff",
    "--warmup-seconds": 240,
    "--window-shares": 400000,
    "--work-timeout": 120
  },
  "soak": {
    "minutes": 25,
    "presets": [
      "tip-delivery-2000-miners-400k-2fe-retarget"
    ],
    "sample_seconds": 15,
    "rollover_minutes": [
      8
    ],
    "rollover_margin_rows": 20000,
    "archive_every_minutes": 4,
    "archive_window_multiple": 1,
    "archive_retention_days": 0,
    "partition_ensure_interval_seconds": 5,
    "gates": {
      "warmup_minutes": 3,
      "min_gated_samples": 40,
      "rss_slope_mib_per_hour_max": 1536,
      "rss_trend_window_minutes": 3,
      "min_trend_windows": 4,
      "rss_warmup_peak_multiple_max": 2.0,
      "rss_expected_failure": null,
      "fd_slope_per_hour_max": 2,
      "pool_connections_max": 24,
      "pool_connections_drift_max": 2,
      "wal_bytes_max": 2147483648,
      "min_rollovers": 1,
      "min_archive_cycles": 0,
      "one_lifetime": true
    }
  }
}
