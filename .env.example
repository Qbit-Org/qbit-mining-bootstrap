QBIT_PROVIDER=git
QBIT_PRODUCTION=0
# Alias accepted by qbit-tools style wrappers.
QBIT_TOOLS_PRODUCTION=0
# Optional runtime mirror of qbit-tools' shared mainnet launch flag. An explicit
# 0 authorizes prelaunch only with mainnet, both production flags at 1, and
# CKPOOL_NON_TEST_READINESS_GATE=0. PRISM self-check then warns only for IBD, a
# missing initial high-diff notification, and too few ready miners; all other
# checks still run and remain fatal. Empty/unset preserves strict self-checks.
QBIT_MAINNET_LAUNCH_READINESS_CHECKS_ENABLED=
# Optional mainnet bootstrap-only qbitd tip age. Leave absent unless a reviewed
# value is required for a stale genesis before the first fresh block. The qbitd
# wrapper requires the full prelaunch authorization tuple and rejects caller-
# supplied -maxtipage/--maxtipage daemon arguments in every mode.
# QBIT_MAINNET_PRELAUNCH_MAX_TIP_AGE_SECONDS=<reviewed-positive-seconds>
QBIT_SRC_DIR=/absolute/path/to/qbit
QBIT_BIN_DIR=
# The public default clones qbit from GitHub and stages it under generated/.
# To use a local checkout instead, set QBIT_PROVIDER=source and QBIT_SRC_DIR.
QBIT_GIT_URL=https://github.com/Qbit-Org/qbit.git
QBIT_GIT_REF=v1.0.0
QBIT_GIT_COMMIT=7ebcddb622d6e639041f005a189b048ec2a221fe
# Leave QBIT_SRC_DIR as-is when QBIT_PROVIDER=git. For source-provider lab
# work, set QBIT_GIT_COMMIT to the checkout commit or clear it in .env.

# Local tags and named volumes are development defaults. Production deployments
# override images with digest-qualified references and state sources with
# absolute host paths.
QBITD_IMAGE=qbit-lab-qbitd:local
CKPOOL_IMAGE=qbit-lab-ckpool:local
BITCOIND_IMAGE=qbit-lab-bitcoind:local
AUXPOW_COORDINATOR_IMAGE=qbit-lab-auxpow-coordinator:local
PRISM_COORDINATOR_IMAGE=qbit-lab-prism-coordinator:local
QBIT_DATA_SOURCE=qbit-data
BITCOIN_DATA_SOURCE=bitcoin-data
PRISM_POSTGRES_DATA_SOURCE=prism-postgres-data
PRISM_POSTGRES_WAL_SOURCE=prism-postgres-wal
PRISM_AUDIT_DATA_SOURCE=prism-audit-data

QBIT_CHAIN=regtest
# Compose defaults this argument to regtest; mainnet deployments must set
# QBIT_CHAIN_FLAG=-chain=main explicitly.
QBIT_CHAIN_FLAG=-regtest
QBIT_NODE_EXTRA_ARG=-asert
QBIT_LISTEN=0
QBIT_RPC_USER=qbitrpc
QBIT_RPC_PASSWORD=change-this
QBIT_RPC_PORT=18452
# Optional complete RPC endpoint for both native Prism services, including
# HTTPS or a proxy path. Empty uses QBIT_RPC_HOST/QBIT_RPC_PORT.
QBIT_RPC_URL=
QBIT_P2P_PORT=18460
QBIT_RPC_PORT_HOST=127.0.0.1:18452
QBIT_P2P_PORT_HOST=127.0.0.1:18460
QBIT_ZMQ_BLOCK_PORT_HOST=127.0.0.1:28332
QBIT_ZMQ_TX_PORT_HOST=127.0.0.1:28333
QBIT_MINER_ADDRESS=auto
MINER_TIMEOUT_SECONDS=180
MINER_USERNAME_TIMEOUT_SECONDS=120

CKPOOL_STRATUM_PORT_HOST=3333
CKPOOL_MINDIFF=
CKPOOL_STARTDIFF=
CKPOOL_MAXDIFF=
CKPOOL_PUBLIC_DIFF_POLICY=explicit
CKPOOL_LOG_DIR=/var/log/ckpool
CKPOOL_SOCK_DIR=/tmp/qbitlab
CKPOOL_NOTIFY=false
# Set this explicitly empty to omit ckpool's optional coinbase signature.
CKPOOL_BTCSIG=/qbit-mining-bootstrap/
CKPOOL_BLOCKPOLL=2
CKPOOL_DONATION=0.0
CKPOOL_NONCE1LENGTH=4
CKPOOL_NONCE2LENGTH=8
CKPOOL_UPDATE_INTERVAL=30
QBIT_REJECTS_WORKER_LIMIT=4096
CKPOOL_NON_TEST_READINESS_GATE=1
CKPOOL_MIN_PEERS=1
CKPOOL_PREFLIGHT_RPC_TIMEOUT_SECONDS=5
CKPOOL_PREFLIGHT_READINESS_TIMEOUT_SECONDS=120
# Continuous supervisor template bounds, polling interval, and failure grace.
CKPOOL_TEMPLATE_MAX_AGE_SECONDS=120
CKPOOL_TEMPLATE_MAX_FUTURE_SECONDS=30
CKPOOL_TEMPLATE_WATCHDOG_POLL_SECONDS=5
CKPOOL_TEMPLATE_FAILURE_EXIT_SECONDS=120
CKPOOL_VALIDATE_QBIT_ASSUMPTIONS=1
CKPOOL_REQUIRE_P2MR_PAYOUT=
QBIT_EXPECTED_ADDRESS_HRP=
# Required on mainnet and optional elsewhere; checked continuously by the supervisor.
QBIT_EXPECTED_GENESIS_HASH=
QBIT_EXPECTED_MAX_BLOCK_WEIGHT=2000000
QBIT_EXPECTED_WITNESS_SCALE_FACTOR=1
QBIT_EXPECTED_COINBASE_MATURITY=1000
# dynamic makes ckpool use qbit getblocktemplate.versionrollingmask when present.
# Older qbitd builds without that field fall back to CKPOOL_VERSION_MASK.
# Direct qbit Stratum services use their own configured fallback masks:
# CKPOOL_VERSION_MASK for ckpool, PRISM_VERSION_ROLLING_MASK for PRISM, and
# AUXPOW_STRATUM_VERSION_MASK for parent-chain AuxPoW Stratum.
# Current qbitd permissionless templates advertise 1fffe000; keep dynamic mode
# enabled so the node remains authoritative when that changes.
CKPOOL_VERSION_MASK_MODE=dynamic
CKPOOL_VERSION_MASK=1fffe000
CKPOOL_VERSION_MASK_RPC_TIMEOUT_SECONDS=5

BITCOIN_CHAIN=regtest
BITCOIN_CHAIN_FLAG=-regtest
BITCOIN_EXPECTED_GENESIS_HASH=
BITCOIN_RPC_USER=bitcoinrpc
BITCOIN_RPC_PASSWORD=change-this
BITCOIN_RPC_PORT=18443
BITCOIN_P2P_PORT=18444
BITCOIN_RPC_PORT_HOST=127.0.0.1:18443
BITCOIN_P2P_PORT_HOST=127.0.0.1:18446
# Regtest lab defaults keep parent-chain peer discovery disabled. Override
# these for a public parent-chain node, or use BITCOIN_NODE_EXTRA_ARGS below.
BITCOIN_DNSSEED=0
# Optional: discover and advertise this node's reachable address.
BITCOIN_DISCOVER=0
# Whitespace-separated bitcoind flags appended after the compose defaults.
# Example: BITCOIN_NODE_EXTRA_ARGS="-dnsseed=1 -addnode=host:48333"
BITCOIN_NODE_EXTRA_ARGS=
BITCOIN_MINER_ADDRESS=auto
BITCOIN_MINER_WALLET_NAME=auxpow-parent

UBUNTU_VERSION=24.04
COMPOSE_PROJECT_NAME=qbit-mining-bootstrap
AUXPOW_BRIDGE_INTERVAL_SECONDS=15
AUXPOW_TEMPLATE_MAX_AGE_SECONDS=120
AUXPOW_TEMPLATE_MAX_FUTURE_SECONDS=7200
AUXPOW_STRATUM_REFRESH_FAILURE_EXIT_SECONDS=120
AUXPOW_STRATUM_PORT_HOST=3335
AUXPOW_STRATUM_SHARE_DIFF=1
AUXPOW_STRATUM_VARDIFF_ENABLED=1
AUXPOW_STRATUM_VARDIFF_TARGET_SHARE_SECONDS=5
AUXPOW_STRATUM_VARDIFF_TARGET_SHARES_PER_SECOND=
AUXPOW_STRATUM_VARDIFF_MIN_DIFF=1024
AUXPOW_STRATUM_VARDIFF_MAX_DIFF=4294967296
AUXPOW_STRATUM_VARDIFF_RETARGET_SECONDS=120
AUXPOW_STRATUM_VARDIFF_MAX_STEP_FACTOR=4
AUXPOW_STRATUM_VARDIFF_MAX_STEP_DOWN_FACTOR=2
AUXPOW_STRATUM_VARDIFF_EWMA_ALPHA=0.4
AUXPOW_STRATUM_VARDIFF_RETARGET_TOLERANCE=0.25
AUXPOW_STRATUM_VARDIFF_STARTUP_DIFF=8192
AUXPOW_STRATUM_VARDIFF_APPLY_MODE=next_job
AUXPOW_STRATUM_POLL_SECONDS=5
AUXPOW_STRATUM_JOB_MAX_AGE_SECONDS=2700
AUXPOW_STRATUM_VERSION_MASK=1fffe000
AUXPOW_STRATUM_HEADER_VARIANT=canonical
AUXPOW_STRATUM_DIAG_JSONL=0
AUXPOW_STRATUM_DIAG_EVENTS=0
AUXPOW_STRATUM_DIAG_VARIANTS=0
AUXPOW_STRATUM_ACCEPT_DIAGNOSTIC_VARIANT=0
AUXPOW_STRATUM_STATS_INTERVAL_SECONDS=60
# Optional JSON map of Stratum username to expected hashes/sec for share-rate diagnostics.
AUXPOW_STRATUM_EXPECTED_HASHRATES=
AUXPOW_MINER_USERNAME=auxpow-smoke
AUXPOW_MINER_PASSWORD=x
AUXPOW_REAL_MINER_THREADS=1
AUXPOW_REAL_MINER_TIMEOUT_SECONDS=120

# Native Rust PRISM. Every instance connects to the same PostgreSQL writer endpoint.
# Stop Python coordinators before enabling the migration; existing ledger rows remain valid.
# For an external HA database use compose.prism-external-db.yaml and set PRISM_DATABASE_URL.
# Each process receives a UUID unless an explicit, unique PRISM_INSTANCE_ID is configured.
PRISM_INSTANCE_ID=
# Empty chooses available CPU parallelism; builder threads perform CPU work concurrently.
PRISM_RUNTIME_WORKERS=
PRISM_DATABASE_MAX_CONNECTIONS=16
PRISM_DATABASE_STATEMENT_TIMEOUT_MS=15000
PRISM_DATABASE_LOCK_TIMEOUT_MS=5000
PRISM_SHARE_COMMIT_TIMEOUT_SECONDS=15
PRISM_STRATUM_MAX_MESSAGE_BYTES=16384
# CTV workers coordinate claims in PostgreSQL across all instances.
PRISM_CTV_BROADCASTER_POLL_SECONDS=30
# Difficulty values below are for regtest. Production requires explicit non-lab values.
# Legacy *_SATS payout options remain aliases for *_BITS options.
# Python worker leases, psql subprocess options, share commit queues, and scheduler tuning
# are obsolete. Accounts/audit snapshots now live in PostgreSQL; the audit mount reads legacy bodies.
PRISM_STRATUM_BIND=0.0.0.0
PRISM_STRATUM_PORT=3340
PRISM_STRATUM_PORT_HOST=3340
PRISM_AUDIT_BIND=127.0.0.1
PRISM_AUDIT_PORT=3341
PRISM_AUDIT_DIR=/var/lib/qbit-prism/audit
PRISM_BLOCKPOLL_SECONDS=2
PRISM_HASHRATE_ROLLUP_ENABLED=1
PRISM_HASHRATE_ROLLUP_INTERVAL_SECONDS=15
PRISM_HASHRATE_ROLLUP_BATCH_SHARES=50000
PRISM_MIN_PEERS=1
PRISM_TEMPLATE_MAX_AGE_SECONDS=120
PRISM_BLOCKWAIT_ENABLED=1
# General node reads and wallet RPCs use their own deadline. The short submit
# deadline applies only to submitblock; ambiguous results recover from the outbox.
PRISM_RPC_TIMEOUT_SECONDS=15
PRISM_BLOCK_SUBMIT_RPC_TIMEOUT_SECONDS=1
PRISM_VERSION_ROLLING_MASK=1fffe000
PRISM_COINBASE_TAG=/PRISM/
# The public read tier runs as `qbit-prism-server public-api` with its own
# PostgreSQL pool. Shared PRISM_PUBLIC_* metadata/cache settings also apply to
# the combined coordinator listener.
PRISM_PUBLIC_API_BIND=0.0.0.0
PRISM_PUBLIC_API_PORT=3342
PRISM_PUBLIC_RUNTIME_WORKERS=2
PRISM_PUBLIC_READ_STATEMENT_TIMEOUT_SECONDS=20
PRISM_POSTGRES_READ_CONCURRENCY=4
PRISM_PUBLIC_API_PORT_HOST=3342
# How often the public read service re-checks that it can reach Postgres for
# its own /healthz. Its answer goes stale after max(3 * this, 15) seconds.
# The same probe carries the replication check below, so it is also how often
# the replica contract is re-evaluated.
PRISM_PUBLIC_READINESS_PROBE_INTERVAL_SECONDS=5
# Read-only DSN for the standby the public tier serves from, using the
# PRISM_POSTGRES_* credentials the base backup cloned from the primary. This is
# deliberately not PRISM_DATABASE_URL: that one names the primary, and the
# coordinator needs it to.
PRISM_PUBLIC_DATABASE_URL=postgresql://qbit:change-this@prism-postgres-replica:5432/qbit
# require = refuse replica-backed routes unless the backing server is in
# recovery and its replication stream is live within the bound below; off =
# serve whatever the DSN points at, which is the pre-replica behaviour. Leave
# this off until a standby is actually provisioned; see
# docs/prism-postgres-replica.md.
PRISM_PUBLIC_REPLICA_MODE=require
# How long the standby's replication stream may go silent before the read tier
# stops treating its answers as current. This bounds the *stream*, not replay
# lag: heartbeats keep flowing on an idle primary, replay lag does not.
PRISM_PUBLIC_REPLICA_MAX_LAG_SECONDS=60
PRISM_PUBLIC_POOL_NAME=PRISM
PRISM_PUBLIC_STRATUM_HOST=
# REQUIRED for prism-public-api: that process runs no Stratum listener, so it
# cannot infer the pool's endpoint. Left empty it refuses to start rather than
# advertise 127.0.0.1 to miners as the pool's Stratum URL.
PRISM_PUBLIC_STRATUM_URL=
PRISM_PUBLIC_STRATUM_HIGHDIFF_URL=
PRISM_PUBLIC_POOL_FEE_BPS=0
PRISM_PUBLIC_CONFIGURATION_LABEL="PRISM default"
PRISM_PUBLIC_CONFIGURATION_DESCRIPTION=
PRISM_PUBLIC_BLOCK_TEMPLATE_POLICY="pool-selected qbit block template with PRISM payout settlement"
PRISM_PUBLIC_MINIMUM_PAYOUT_BITS=
PRISM_PUBLIC_HASHRATE_SMOOTHING_SECONDS=1800
PRISM_PUBLIC_EXPLORER_TX_URL_PREFIX=
PRISM_PUBLIC_EXPLORER_BLOCK_URL_PREFIX=
PRISM_PUBLIC_CACHE_ENABLED=1
PRISM_PUBLIC_CACHE_TTL_SECONDS=5
PRISM_PUBLIC_CACHE_STALE_WHILE_REVALIDATE_SECONDS=30
PRISM_PUBLIC_AGGREGATE_CACHE_TTL_SECONDS=30
PRISM_PUBLIC_AGGREGATE_CACHE_STALE_WHILE_REVALIDATE_SECONDS=30
PRISM_PUBLIC_CONFIG_CACHE_TTL_SECONDS=300
PRISM_PUBLIC_CONFIG_CACHE_STALE_WHILE_REVALIDATE_SECONDS=3600
PRISM_PUBLIC_ARTIFACT_CACHE_TTL_SECONDS=86400
PRISM_PUBLIC_ARTIFACT_CACHE_STALE_WHILE_REVALIDATE_SECONDS=86400
PRISM_PUBLIC_CACHE_MAX_ENTRIES=512
PRISM_PUBLIC_CACHE_MAX_RESPONSE_BYTES=1048576
PRISM_PUBLIC_CACHE_DEBUG_HEADERS=0
PRISM_STRATUM_EXTRANONCE2_SIZE=8
PRISM_STRATUM_SHARE_DIFF=0.000000001
PRISM_STRATUM_VARDIFF=1
QBIT_REQUIRE_RELEASE_PROVENANCE=0
PRISM_STRATUM_VARDIFF_TARGET_SECONDS=15
PRISM_STRATUM_VARDIFF_MIN_DIFF=0.000000001
PRISM_STRATUM_VARDIFF_MAX_DIFF=1024
PRISM_STRATUM_VARDIFF_RETARGET_SECONDS=90
PRISM_STRATUM_VARDIFF_MAX_STEP_UP=4
PRISM_STRATUM_VARDIFF_MAX_STEP_DOWN=4
PRISM_STRATUM_VARDIFF_START_DIFF=0.000000001
PRISM_STRATUM_VARDIFF_EWMA_ALPHA=0.4
# Persist accepted-work evidence across reconnects, listeners, and frontends.
PRISM_STRATUM_VARDIFF_RESUME=1
PRISM_STRATUM_VARDIFF_RESUME_TTL_SECONDS=900
PRISM_STRATUM_VARDIFF_RESUME_MAX_ENTRIES=8192
PRISM_STRATUM_VARDIFF_RESUME_MAX_START_FACTOR=1024
PRISM_STRATUM_VARDIFF_INITIAL_CONVERGENCE=1
PRISM_STRATUM_VARDIFF_INITIAL_MAX_STEP_UP=64
PRISM_STRATUM_VARDIFF_INITIAL_MIN_SHARES=8
PRISM_STRATUM_VARDIFF_INITIAL_MIN_STEP_UP=4
PRISM_STRATUM_VARDIFF_INITIAL_MIN_SECONDS=1
PRISM_STRATUM_VARDIFF_RETARGET_TOLERANCE=0.25
PRISM_STRATUM_STALE_GRACE_SECONDS=3
PRISM_STRATUM_SAME_TIP_JOB_RETENTION_SECONDS=30
PRISM_STRATUM_SAME_TIP_JOB_RETENTION_PER_CONNECTION=64
PRISM_PAYOUT_ARTIFACT_REANCHOR_SECONDS=60
PRISM_STRATUM_MAX_CONNECTIONS=384
PRISM_STRATUM_MAX_CONNECTIONS_PER_USERNAME=0
PRISM_STRATUM_MAX_PENDING_INITIAL_JOBS=128
PRISM_STRATUM_INITIAL_JOB_TIMEOUT_SECONDS=30
PRISM_JOB_BUILD_EXECUTOR_WORKERS=2
PRISM_COORDINATOR_NOFILE_SOFT=65536
PRISM_COORDINATOR_NOFILE_HARD=524288
PRISM_STRATUM_HIGHDIFF_PORT=
PRISM_STRATUM_HIGHDIFF_PORT_HOST=
PRISM_STRATUM_HIGHDIFF_BIND=
PRISM_STRATUM_HIGHDIFF_START_DIFF=500000
PRISM_STRATUM_HIGHDIFF_MIN_DIFF=500000
PRISM_STRATUM_HIGHDIFF_MAX_DIFF=4294967296
PRISM_STRATUM_HIGHDIFF_SHARE_DIFF=
# Used for explicitly invalid or unsupported addresses. RPC failures reject authorization.
PRISM_USERNAME_FALLBACK_ADDRESS=
PRISM_PAYOUT_MIN_OUTPUT_SATS=
PRISM_PAYOUT_P2MR_SPEND_INPUT_BYTES=3680
PRISM_PAYOUT_TARGET_FEERATE_SATS_PER_BYTE=1
PRISM_PAYOUT_SAFETY_MULTIPLIER=4
PRISM_CTV_SETTLEMENT_ENABLED=0
PRISM_CTV_FANOUT_FEE_MARKET_RATE_BITS_PER_1000_WEIGHT=
PRISM_CTV_FANOUT_FEE_PREMIUM_BPS=12000
PRISM_CTV_BROADCASTER_ENABLED=
PRISM_CTV_SPEND_SCAN_BLOCKS=32
PRISM_CTV_BROADCASTER_WALLET=
PRISM_CTV_BROADCASTER_FEE_BITS=0
PRISM_CTV_BROADCASTER_LIMIT=100
PRISM_POOL_FEE_ENABLED=0
PRISM_POOL_FEE_BPS=
PRISM_POOL_FEE_ADDRESS=
PRISM_POOL_FEE_P2MR_PROGRAM_HEX=
PRISM_POOL_FEE_RECIPIENT_ID=
PRISM_POOL_FEE_ORDER_KEY=
PRISM_COINBASE_OUTPUT_POLICY=canonical
PRISM_POSTGRES_IMAGE=postgres:16-alpine
PRISM_POSTGRES_DB=qbit
PRISM_POSTGRES_USER=qbit
PRISM_POSTGRES_PASSWORD=change-this
PRISM_DATABASE_URL=postgresql://qbit:change-this@prism-postgres:5432/qbit
PRISM_POSTGRES_INIT_SCHEMA=1
PRISM_HEALTH_TIP_POLL_MAX_AGE_SECONDS=15
PRISM_LEDGER_WRITER_PUBLIC_KEY_HEX=
PRISM_MANIFEST_SIGNING_SEED_HEX=
PRISM_LEDGER_ATTESTATION_SIGNING_SEED_HEX=
PRISM_ALLOW_MEMORY_LEDGER=0
PRISM_ALLOW_TEST_SIGNING_SEEDS=0
PRISM_ALLOW_BUNDLE_EMBEDDED_LEDGER_KEY=0
PRISM_ALLOW_FIXED_LEDGER_SESSION_TOKEN=0

# Signet overrides:
# QBIT_CHAIN=signet
# QBIT_CHAIN_FLAG=-signet
# QBIT_NODE_EXTRA_ARG=-signetchallenge=<your_signet_challenge_hex>
# QBIT_LISTEN=0
# QBIT_RPC_PORT=38352
# QBIT_P2P_PORT=38355
# QBIT_RPC_PORT_HOST=127.0.0.1:38352
# QBIT_P2P_PORT_HOST=127.0.0.1:38355
# QBIT_MINER_ADDRESS=auto
# CKPOOL_MINDIFF=<reviewed-share-floor>
# CKPOOL_STARTDIFF=<reviewed-starting-share-difficulty>
# CKPOOL_MAXDIFF=<optional-share-difficulty-cap>
#
# qbitd stays private by default. To intentionally run a reachable qbit peer,
# set QBIT_LISTEN=1 and publish QBIT_P2P_PORT_HOST=0.0.0.0:<p2p-port>.
#
# Optional live parent-chain overrides for AuxPoW operator mode:
# BITCOIN_RPC_HOST=<your_parent_node_host>
# BITCOIN_RPC_PORT=<your_parent_node_rpc_port>
# BITCOIN_RPC_USER=<your_parent_node_rpc_user>
# BITCOIN_RPC_PASSWORD=<your_parent_node_rpc_password>
# BITCOIN_MINER_ADDRESS=<your_bitcoin_payout_address>
#
# Local Bitcoin testnet4 parent-node example:
# BITCOIN_CHAIN_FLAG=-testnet4
# BITCOIN_RPC_PORT=48332
# BITCOIN_P2P_PORT=48333
# BITCOIN_RPC_PORT_HOST=127.0.0.1:48332
# BITCOIN_P2P_PORT_HOST=127.0.0.1:48333
# BITCOIN_DNSSEED=1
# BITCOIN_DISCOVER=0
# BITCOIN_NODE_EXTRA_ARGS=
# BITCOIN_MINER_ADDRESS=<your_bitcoin_testnet4_payout_address>
#
# Equivalent discovery override using the general extra-args hook:
# BITCOIN_NODE_EXTRA_ARGS="-dnsseed=1"
