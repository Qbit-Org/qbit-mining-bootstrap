QBIT_PROVIDER=git
QBIT_PRODUCTION=0
# Alias accepted by qbit-tools style wrappers.
QBIT_TOOLS_PRODUCTION=0
# Optional runtime mirror of qbit-tools' shared mainnet launch flag. An explicit
# 0 authorizes prelaunch only with mainnet, both production flags at 1, and
# CKPOOL_NON_TEST_READINESS_GATE=0. PRISM self-check then warns only for IBD, a
# missing initial high-diff notification, and too few ready miners; all other
# checks still run and remain fatal. Empty/unset preserves strict self-checks.
QBIT_MAINNET_LAUNCH_READINESS_CHECKS_ENABLED=
# Optional mainnet bootstrap-only qbitd tip age. Leave absent unless a reviewed
# value is required for a stale genesis before the first fresh block. The qbitd
# wrapper requires the full prelaunch authorization tuple and rejects caller-
# supplied -maxtipage/--maxtipage daemon arguments in every mode.
# QBIT_MAINNET_PRELAUNCH_MAX_TIP_AGE_SECONDS=<reviewed-positive-seconds>
QBIT_SRC_DIR=/absolute/path/to/qbit
QBIT_BIN_DIR=
# The public default clones qbit from GitHub and stages it under generated/.
# To use a local checkout instead, set QBIT_PROVIDER=source and QBIT_SRC_DIR.
QBIT_GIT_URL=https://github.com/Qbit-Org/qbit.git
QBIT_GIT_REF=v1.0.0
QBIT_GIT_COMMIT=7ebcddb622d6e639041f005a189b048ec2a221fe
# Leave QBIT_SRC_DIR as-is when QBIT_PROVIDER=git. For source-provider lab
# work, set QBIT_GIT_COMMIT to the checkout commit or clear it in .env.

# Local tags and named volumes are development defaults. Production deployments
# override images with digest-qualified references and state sources with
# absolute host paths.
QBITD_IMAGE=qbit-lab-qbitd:local
CKPOOL_IMAGE=qbit-lab-ckpool:local
BITCOIND_IMAGE=qbit-lab-bitcoind:local
AUXPOW_COORDINATOR_IMAGE=qbit-lab-auxpow-coordinator:local
PRISM_COORDINATOR_IMAGE=qbit-lab-prism-coordinator:local
QBIT_DATA_SOURCE=qbit-data
BITCOIN_DATA_SOURCE=bitcoin-data
PRISM_POSTGRES_DATA_SOURCE=prism-postgres-data
PRISM_POSTGRES_WAL_SOURCE=prism-postgres-wal
PRISM_AUDIT_DATA_SOURCE=prism-audit-data

QBIT_CHAIN=regtest
# Compose defaults this argument to regtest; mainnet deployments must set
# QBIT_CHAIN_FLAG=-chain=main explicitly.
QBIT_CHAIN_FLAG=-regtest
QBIT_NODE_EXTRA_ARG=-asert
QBIT_LISTEN=0
QBIT_RPC_USER=qbitrpc
QBIT_RPC_PASSWORD=change-this
QBIT_RPC_PORT=18452
QBIT_P2P_PORT=18460
QBIT_RPC_PORT_HOST=127.0.0.1:18452
QBIT_P2P_PORT_HOST=127.0.0.1:18460
QBIT_ZMQ_BLOCK_PORT_HOST=127.0.0.1:28332
QBIT_ZMQ_TX_PORT_HOST=127.0.0.1:28333
QBIT_MINER_ADDRESS=auto
MINER_TIMEOUT_SECONDS=180
MINER_USERNAME_TIMEOUT_SECONDS=120

CKPOOL_STRATUM_PORT_HOST=3333
CKPOOL_MINDIFF=
CKPOOL_STARTDIFF=
CKPOOL_MAXDIFF=
CKPOOL_PUBLIC_DIFF_POLICY=explicit
CKPOOL_LOG_DIR=/var/log/ckpool
CKPOOL_SOCK_DIR=/tmp/qbitlab
CKPOOL_NOTIFY=false
# Set this explicitly empty to omit ckpool's optional coinbase signature.
CKPOOL_BTCSIG=/qbit-mining-bootstrap/
CKPOOL_BLOCKPOLL=2
CKPOOL_DONATION=0.0
CKPOOL_NONCE1LENGTH=4
CKPOOL_NONCE2LENGTH=8
CKPOOL_UPDATE_INTERVAL=30
QBIT_REJECTS_WORKER_LIMIT=4096
CKPOOL_NON_TEST_READINESS_GATE=1
CKPOOL_MIN_PEERS=1
CKPOOL_PREFLIGHT_RPC_TIMEOUT_SECONDS=5
CKPOOL_PREFLIGHT_READINESS_TIMEOUT_SECONDS=120
# Continuous supervisor template bounds, polling interval, and failure grace.
CKPOOL_TEMPLATE_MAX_AGE_SECONDS=120
CKPOOL_TEMPLATE_MAX_FUTURE_SECONDS=30
CKPOOL_TEMPLATE_WATCHDOG_POLL_SECONDS=5
CKPOOL_TEMPLATE_FAILURE_EXIT_SECONDS=120
CKPOOL_VALIDATE_QBIT_ASSUMPTIONS=1
CKPOOL_REQUIRE_P2MR_PAYOUT=
QBIT_EXPECTED_ADDRESS_HRP=
# Required on mainnet and optional elsewhere; checked continuously by the supervisor.
QBIT_EXPECTED_GENESIS_HASH=
QBIT_EXPECTED_MAX_BLOCK_WEIGHT=2000000
QBIT_EXPECTED_WITNESS_SCALE_FACTOR=1
QBIT_EXPECTED_COINBASE_MATURITY=1000
# dynamic makes ckpool use qbit getblocktemplate.versionrollingmask when present.
# Older qbitd builds without that field fall back to CKPOOL_VERSION_MASK.
# Direct qbit Stratum services use their own configured fallback masks:
# CKPOOL_VERSION_MASK for ckpool, PRISM_VERSION_ROLLING_MASK for PRISM, and
# AUXPOW_STRATUM_VERSION_MASK for parent-chain AuxPoW Stratum.
# Current qbitd permissionless templates advertise 1fffe000; keep dynamic mode
# enabled so the node remains authoritative when that changes.
CKPOOL_VERSION_MASK_MODE=dynamic
CKPOOL_VERSION_MASK=1fffe000
CKPOOL_VERSION_MASK_RPC_TIMEOUT_SECONDS=5

BITCOIN_CHAIN=regtest
BITCOIN_CHAIN_FLAG=-regtest
BITCOIN_EXPECTED_GENESIS_HASH=
BITCOIN_RPC_USER=bitcoinrpc
BITCOIN_RPC_PASSWORD=change-this
BITCOIN_RPC_PORT=18443
BITCOIN_P2P_PORT=18444
BITCOIN_RPC_PORT_HOST=127.0.0.1:18443
BITCOIN_P2P_PORT_HOST=127.0.0.1:18446
# Regtest lab defaults keep parent-chain peer discovery disabled. Override
# these for a public parent-chain node, or use BITCOIN_NODE_EXTRA_ARGS below.
BITCOIN_DNSSEED=0
# Optional: discover and advertise this node's reachable address.
BITCOIN_DISCOVER=0
# Whitespace-separated bitcoind flags appended after the compose defaults.
# Example: BITCOIN_NODE_EXTRA_ARGS="-dnsseed=1 -addnode=host:48333"
BITCOIN_NODE_EXTRA_ARGS=
BITCOIN_MINER_ADDRESS=auto
BITCOIN_MINER_WALLET_NAME=auxpow-parent

UBUNTU_VERSION=24.04
COMPOSE_PROJECT_NAME=qbit-mining-bootstrap
AUXPOW_BRIDGE_INTERVAL_SECONDS=15
AUXPOW_TEMPLATE_MAX_AGE_SECONDS=120
AUXPOW_TEMPLATE_MAX_FUTURE_SECONDS=7200
AUXPOW_STRATUM_REFRESH_FAILURE_EXIT_SECONDS=120
AUXPOW_STRATUM_PORT_HOST=3335
AUXPOW_STRATUM_SHARE_DIFF=1
AUXPOW_STRATUM_VARDIFF_ENABLED=1
AUXPOW_STRATUM_VARDIFF_TARGET_SHARE_SECONDS=5
AUXPOW_STRATUM_VARDIFF_TARGET_SHARES_PER_SECOND=
AUXPOW_STRATUM_VARDIFF_MIN_DIFF=1024
AUXPOW_STRATUM_VARDIFF_MAX_DIFF=4294967296
AUXPOW_STRATUM_VARDIFF_RETARGET_SECONDS=120
AUXPOW_STRATUM_VARDIFF_MAX_STEP_FACTOR=4
AUXPOW_STRATUM_VARDIFF_MAX_STEP_DOWN_FACTOR=2
AUXPOW_STRATUM_VARDIFF_EWMA_ALPHA=0.4
AUXPOW_STRATUM_VARDIFF_RETARGET_TOLERANCE=0.25
AUXPOW_STRATUM_VARDIFF_STARTUP_DIFF=8192
AUXPOW_STRATUM_VARDIFF_APPLY_MODE=next_job
AUXPOW_STRATUM_POLL_SECONDS=5
AUXPOW_STRATUM_JOB_MAX_AGE_SECONDS=2700
AUXPOW_STRATUM_VERSION_MASK=1fffe000
AUXPOW_STRATUM_HEADER_VARIANT=canonical
AUXPOW_STRATUM_DIAG_JSONL=0
AUXPOW_STRATUM_DIAG_EVENTS=0
AUXPOW_STRATUM_DIAG_VARIANTS=0
AUXPOW_STRATUM_ACCEPT_DIAGNOSTIC_VARIANT=0
AUXPOW_STRATUM_STATS_INTERVAL_SECONDS=60
# Optional JSON map of Stratum username to expected hashes/sec for share-rate diagnostics.
AUXPOW_STRATUM_EXPECTED_HASHRATES=
AUXPOW_MINER_USERNAME=auxpow-smoke
AUXPOW_MINER_PASSWORD=x
AUXPOW_REAL_MINER_THREADS=1
AUXPOW_REAL_MINER_TIMEOUT_SECONDS=120

# Direct PRISM Stratum. Production should use Postgres, real signing seeds, and
# a trusted ledger public key distributed out of band from audit bundles.
PRISM_STRATUM_BIND=0.0.0.0
PRISM_STRATUM_PORT=3340
PRISM_STRATUM_PORT_HOST=3340
PRISM_AUDIT_BIND=127.0.0.1
PRISM_AUDIT_PORT=3341
PRISM_AUDIT_DIR=/var/lib/qbit-prism/audit
PRISM_AUDIT_SHARE_SEGMENT_SIZE=10000
PRISM_AUDIT_LIVE_BUNDLE_RETENTION=5
PRISM_AUDIT_CANDIDATE_RETENTION_SECONDS=86400
PRISM_CTV_BROADCAST_ATTEMPT_DETAIL_LIMIT=20
PRISM_CTV_BROADCAST_RETRY_BACKOFF_SECONDS=300
PRISM_EVIDENCE_PATH=/var/lib/qbit-prism/audit/prism-live-evidence.json
PRISM_STOP_AFTER_BLOCK=0
PRISM_MAX_BLOCKS=2147483647
PRISM_BLOCKPOLL_SECONDS=2
PRISM_BLOCKWAIT_ENABLED=1
PRISM_BLOCKWAIT_TIMEOUT_SECONDS=5
# Found-block fast lane: submitblock runs before writer admission/accounting.
PRISM_BLOCK_SUBMIT_RPC_TIMEOUT_SECONDS=1
# Fresh deadline for each submitter Postgres statement and local DB gate
# (cheap outbox polls and fast-lane-adjacent calls only).
PRISM_BLOCK_SUBMIT_DB_TIMEOUT_SECONDS=1
# Landing-class deadline for the post-acceptance accounting tail (persist,
# prior balances, confirm, prepared-state rejection). Must stay well above
# the poll budget; see issue #188.
PRISM_BLOCK_LANDING_DB_TIMEOUT_SECONDS=30
# Cap for the escalated landing deadline on timed-out landing retries.
PRISM_BLOCK_LANDING_DB_TIMEOUT_MAX_SECONDS=120
# Fail-closed bound on landed-but-unresolved accepted-parent transitions.
PRISM_ACCEPTED_PARENT_UNRESOLVED_DEPTH_MAX=8
# Emit the contended lock and current submitter phase at this cadence.
PRISM_BLOCK_SUBMIT_LOCK_WAIT_LOG_SECONDS=5
# Exit nonzero when a timeout-ignoring RPC/DB worker pool stays exhausted this long.
PRISM_BLOCK_SUBMIT_STUCK_CALL_EXIT_SECONDS=30
PRISM_REORG_RECONCILER_ENABLED=1
PRISM_VERSION_ROLLING_MASK=1fffe000
PRISM_COINBASE_TAG=/PRISM/
# The /public/v1 read surface runs in its own process (the prism-public-api
# compose service, `python3 -m lab.prism.public_read_service`). Every
# PRISM_PUBLIC_* knob below is read by that service, not by prism-coordinator.
# PRISM_PUBLIC_REWARD_WINDOW_CACHE_SECONDS (further down) is the one exception:
# it is read by the ledger, and both processes construct one.
PRISM_PUBLIC_API_BIND=0.0.0.0
PRISM_PUBLIC_API_PORT=3342
PRISM_PUBLIC_API_PORT_HOST=3342
# How often the public read service re-checks that it can reach Postgres for
# its own /healthz. Its answer goes stale after max(3 * this, 15) seconds.
# The same probe carries the replication check below, so it is also how often
# the replica contract is re-evaluated.
PRISM_PUBLIC_READINESS_PROBE_INTERVAL_SECONDS=5
# Read-only DSN for the standby the public tier serves from, using the
# PRISM_POSTGRES_* credentials the base backup cloned from the primary. This is
# deliberately not PRISM_DATABASE_URL: that one names the primary, and the
# coordinator needs it to.
PRISM_PUBLIC_DATABASE_URL=postgresql://qbit:change-this@prism-postgres-replica:5432/qbit
# require = refuse replica-backed routes unless the backing server is in
# recovery and its replication stream is live within the bound below; off =
# serve whatever the DSN points at, which is the pre-replica behaviour. Leave
# this off until a standby is actually provisioned; see
# docs/prism-postgres-replica.md.
PRISM_PUBLIC_REPLICA_MODE=require
# How long the standby's replication stream may go silent before the read tier
# stops treating its answers as current. This bounds the *stream*, not replay
# lag: heartbeats keep flowing on an idle primary, replay lag does not.
PRISM_PUBLIC_REPLICA_MAX_LAG_SECONDS=60
PRISM_PUBLIC_POOL_NAME=PRISM
PRISM_PUBLIC_STRATUM_HOST=
# REQUIRED for prism-public-api: that process runs no Stratum listener, so it
# cannot infer the pool's endpoint. Left empty it refuses to start rather than
# advertise 127.0.0.1 to miners as the pool's Stratum URL.
PRISM_PUBLIC_STRATUM_URL=
# Optional external URL for the high-diff endpoint in /public/v1/mining-configuration.
# Used only when PRISM_STRATUM_HIGHDIFF_PORT is set; empty derives from
# PRISM_PUBLIC_STRATUM_URL first, then PRISM_PUBLIC_STRATUM_HOST, plus
# PRISM_STRATUM_HIGHDIFF_PORT.
PRISM_PUBLIC_STRATUM_HIGHDIFF_URL=
PRISM_PUBLIC_POOL_FEE_BPS=0
PRISM_PUBLIC_CONFIGURATION_LABEL="PRISM default"
PRISM_PUBLIC_CONFIGURATION_DESCRIPTION=
PRISM_PUBLIC_BLOCK_TEMPLATE_POLICY="pool-selected qbit block template with PRISM payout settlement"
PRISM_PUBLIC_MINIMUM_PAYOUT_BITS=
# Trailing window (seconds) used to steady /public/v1/hashrate-series points on
# sub-window buckets (5m); 0 serves raw per-bucket rates. Clamped to [0, 86400].
PRISM_PUBLIC_HASHRATE_SMOOTHING_SECONDS=1800
PRISM_PUBLIC_EXPLORER_TX_URL_PREFIX=
PRISM_PUBLIC_EXPLORER_BLOCK_URL_PREFIX=
PRISM_PUBLIC_CACHE_ENABLED=1
PRISM_PUBLIC_CACHE_TTL_SECONDS=5
PRISM_PUBLIC_CACHE_STALE_WHILE_REVALIDATE_SECONDS=30
# Pool-wide aggregate endpoints (pool-summary, hashrate-series, miner workers)
# are expensive to recompute and tolerate more staleness than row reads.
PRISM_PUBLIC_AGGREGATE_CACHE_TTL_SECONDS=30
PRISM_PUBLIC_AGGREGATE_CACHE_STALE_WHILE_REVALIDATE_SECONDS=30
PRISM_PUBLIC_CONFIG_CACHE_TTL_SECONDS=300
PRISM_PUBLIC_CONFIG_CACHE_STALE_WHILE_REVALIDATE_SECONDS=3600
PRISM_PUBLIC_ARTIFACT_CACHE_TTL_SECONDS=86400
PRISM_PUBLIC_ARTIFACT_CACHE_STALE_WHILE_REVALIDATE_SECONDS=86400
PRISM_PUBLIC_CACHE_MAX_ENTRIES=512
PRISM_PUBLIC_CACHE_MAX_RESPONSE_BYTES=1048576
PRISM_PUBLIC_CACHE_DEBUG_HEADERS=0
PRISM_STRATUM_EXTRANONCE2_SIZE=8
PRISM_STRATUM_SHARE_DIFF=0.000000001
PRISM_STRATUM_SHARE_WEIGHT=1
PRISM_STRATUM_SHARE_WEIGHTS_JSON=
PRISM_STRATUM_VARDIFF=1
# The 1e-9 values below are for local labs. Production requires reviewed,
# explicit non-lab difficulty values.
# Release provenance (digest-qualified *_IMAGE references and absolute
# *_DATA_SOURCE host paths) is always enforced when QBIT_CHAIN=mainnet; no
# variable can disable it there. Set this to 1 to hold another chain to the same
# contract. Leave it 0 for production pools that build images from the pinned
# source (for example a public testnet4 deployment), which keeps every
# behavioral production check active.
QBIT_REQUIRE_RELEASE_PROVENANCE=0
PRISM_STRATUM_VARDIFF_TARGET_SECONDS=15
PRISM_STRATUM_VARDIFF_MIN_DIFF=0.000000001
PRISM_STRATUM_VARDIFF_MAX_DIFF=1024
PRISM_STRATUM_VARDIFF_RETARGET_SECONDS=90
PRISM_STRATUM_VARDIFF_MAX_STEP_UP=4
PRISM_STRATUM_VARDIFF_MAX_STEP_DOWN=4
PRISM_STRATUM_VARDIFF_START_DIFF=0.000000001
PRISM_STRATUM_VARDIFF_EWMA_ALPHA=0.4
PRISM_STRATUM_VARDIFF_RETARGET_TOLERANCE=0.25
# Set to 0 to disable idle zero-share vardiff step-down sweeps.
PRISM_STRATUM_VARDIFF_IDLE_SWEEP_SECONDS=15
# Reconnect difficulty resume: a reconnecting worker (same listener + exact
# username) starts at its last converged difficulty instead of the lane
# start, so a mass reconnect does not re-flood the share path while every
# session re-climbs. 0 restores lane-start behavior exactly.
# LIMITATION: retention is keyed by (listener, exact Stratum username) and is
# last-writer-wins, so heterogeneous rigs that deliberately share one username
# share one retained value: a small rig reconnecting after a big one can adopt
# the big rig's converged difficulty (and vice versa) until its own shares
# retarget it. The adopted value is still bounded by the lane clamp below.
# Give each rig its own worker name (address.rig) to keep the values separate;
# PRISM_STRATUM_MAX_CONNECTIONS_PER_USERNAME bounds how many connections can
# share one identity in the first place.
# LIMITATION: the retention store is in-memory and process-local. Any
# coordinator restart — including the liveness watchdog's terminal
# exit_process(1) — empties it, so the mass-reconnect wave right after a
# restart finds nothing to resume and every session starts at lane start.
# Do not rely on retention to absorb a restart-driven reconnect storm.
PRISM_STRATUM_VARDIFF_RESUME=1
# How long a retained difficulty stays adoptable. WARNING: when
# PRISM_STRATUM_VARDIFF_IDLE_SWEEP_SECONDS=0 (as deployed) there is no idle
# step-down sweep, so a session resumed above its true hashrate can only be
# corrected by an accepted share; keep this TTL short enough that retained
# values still reflect recent hashrate. The TTL always measures the age of the
# converged value itself: reconnecting and disconnecting without submitting a
# share does not extend it.
PRISM_STRATUM_VARDIFF_RESUME_TTL_SECONDS=900
# Bound on retained per-worker entries (2x the deployed 4096 connection cap).
PRISM_STRATUM_VARDIFF_RESUME_MAX_ENTRIES=8192
# Plausibility ceiling for a resumed value, as a multiple of the lane's own
# start difficulty (1024 = five 4x retarget steps). A retained value above
# min(lane max difficulty, start * factor) is clamped before adoption.
# WARNING: with PRISM_STRATUM_VARDIFF_IDLE_SWEEP_SECONDS=0 (as deployed), a
# rig that converged high and reconnects within the TTL on weaker hardware
# can resume too high, emit no shares, and give the retargeter no signal to
# come down — stuck for that connection's life (bounded by the TTL above;
# only that miner is harmed). On hardware where converged-high rigs stall
# after resume, lower this factor.
PRISM_STRATUM_VARDIFF_RESUME_MAX_START_FACTOR=1024
# Seconds a share computed against the just-replaced tip is still credited
# (never block-submitted). Mainnet requires 0; other chains may keep a small
# window that covers miner job-switch latency.
PRISM_STRATUM_STALE_GRACE_SECONDS=3
# Clean same-tip jobs remain valid against their original context for this
# bounded window. Set the TTL to 0 to disable; positive TTLs require positive
# per-connection caps. Production additionally requires a positive pool-wide
# connection limit, bounding retained contexts by the product of both limits.
PRISM_STRATUM_SAME_TIP_JOB_RETENTION_SECONDS=30
PRISM_STRATUM_SAME_TIP_JOB_RETENTION_PER_CONNECTION=64
# Staged latest-wins tip-refresh epochs. Leave disabled until rollout.
PRISM_TIP_REFRESH_EPOCH_FANOUT=0
# Same-tip contexts retained past their connection's disconnect so a
# same-username reconnect (proxy flap) can submit in-flight work instead of
# eating unknown-job rejects. Count cap across all dead connections; entries
# keep the same-tip retention TTL. 0 restores purge-on-disconnect.
PRISM_STRATUM_DISCONNECTED_JOB_RETENTION=16384
# Persistent ready-pool fanout workers. Values above 16 are rejected.
PRISM_TIP_REFRESH_MAX_WORKERS=16
PRISM_BUNDLE_BUILD_TIMEOUT_SECONDS=60
# Reuse one exact payout window across routine generations. Normal delta
# refreshes are limited to the re-anchor cadence; found-block settlement
# bypasses the interval, and the full oracle periodically checks parity.
PRISM_PAYOUT_ARTIFACT_REUSE=1
PRISM_PAYOUT_ARTIFACT_REARM_MIN_SECONDS=5
PRISM_PAYOUT_ARTIFACT_REANCHOR_SECONDS=60
PRISM_PAYOUT_ARTIFACT_MIN_BUILD_INTERVAL_SECONDS=60
PRISM_PAYOUT_ARTIFACT_FULL_RESCAN_SECONDS=3600
PRISM_PAYOUT_ARTIFACT_MAX_ANCHOR_AGE_SECONDS=300
# Route the payout-window fold, canonical digest, and incremental advance
# through the persistent --serve audit builder instead of in-process Python.
# Strictly boolean (anything else refuses startup); inert while the daemon
# transport is disabled, and any daemon anomaly still degrades to the
# in-process pipeline for that materialization without flipping this. The
# daemon carries integers in fixed widths (share_difficulty/network_difficulty
# u128, share_seq/template_height u64, ntime u32, millisecond stamps i64); a
# window holding a value beyond them is declined as out_of_range and folded
# in-process, with the daemon kept alive.
PRISM_WINDOW_PIPELINE_RUST=0
PRISM_WORKER_METRICS_LIMIT=100
# Global thread-per-connection capacity across every PRISM listener. The
# production-facing default is above the normal 200-250 connection population;
# set it explicitly to 0 only for focused local/regtest unlimited operation.
PRISM_STRATUM_MAX_CONNECTIONS=384
PRISM_STRATUM_MAX_CONNECTIONS_PER_USERNAME=0
# Bound authorized clients awaiting first current-tip work and expire them if
# delivery cannot make progress. A zero timeout disables expiry for focused
# tests; the pending-client bound remains positive.
PRISM_STRATUM_MAX_PENDING_INITIAL_JOBS=128
PRISM_STRATUM_INITIAL_JOB_TIMEOUT_SECONDS=30
# Dedicated first-job delivery workers. Raise under reconnect churn so first
# notifies do not queue behind each other; the pending-client bound above is
# the ceiling, since extra workers past it can never receive a task.
PRISM_INITIAL_JOB_MAX_WORKERS=4
# Shared job-build executor threads. The scheduler admits at most two
# concurrent build flights, so values above 2 are rejected; lower to 1 to
# serialize builds on GIL-constrained single-core hosts.
PRISM_JOB_BUILD_EXECUTOR_WORKERS=2
# Suppress mining-delivery health failures during bounded startup preparation.
PRISM_MINING_HEALTH_STARTUP_GRACE_SECONDS=30
# Keep listener threads alive during transient process/system descriptor
# exhaustion instead of waiting for the watchdog to restart the coordinator.
PRISM_STRATUM_ACCEPT_RESOURCE_EXHAUSTION_BACKOFF_SECONDS=1
# Successful payout-address validations use a bounded LRU/TTL cache. Set either
# value to 0 to disable caching without disabling concurrent request deduping.
PRISM_PAYOUT_ADDRESS_CACHE_MAX_ENTRIES=4096
PRISM_PAYOUT_ADDRESS_CACHE_TTL_SECONDS=3600
# Raise the coordinator's soft descriptor allowance without lowering the
# existing deployment's hard ceiling.
PRISM_COORDINATOR_NOFILE_SOFT=65536
PRISM_COORDINATOR_NOFILE_HARD=524288
# Optional second Stratum listener for rental-scale miners (e.g. NiceHash
# orders, which require a >=500000 share difficulty from the first
# mining.set_difficulty they see). Disabled unless PRISM_STRATUM_HIGHDIFF_PORT
# is set. Difficulty bounds are independent of the default listener; all other
# vardiff knobs (target/retarget/steps) inherit PRISM_STRATUM_VARDIFF_*.
# Clients may raise (never lower) their difficulty within these bounds via the
# password convention d=N,md=N or mining.suggest_difficulty.
PRISM_STRATUM_HIGHDIFF_PORT=
# Host publish mapping for the high-diff listener. Leave empty while the
# listener is disabled (compose then maps an ephemeral loopback port so host
# 4334 is never occupied); set to 4334 together with
# PRISM_STRATUM_HIGHDIFF_PORT when enabling it.
PRISM_STRATUM_HIGHDIFF_PORT_HOST=
PRISM_STRATUM_HIGHDIFF_BIND=
PRISM_STRATUM_HIGHDIFF_START_DIFF=500000
# MIN_DIFF is a wire guarantee: stamped jobs advertise at least this value
# even while qbit network difficulty is below it (young chain, test networks),
# because marketplace verification judges the first mining.set_difficulty.
PRISM_STRATUM_HIGHDIFF_MIN_DIFF=500000
PRISM_STRATUM_HIGHDIFF_MAX_DIFF=4294967296
# Fixed difficulty when vardiff is disabled; empty tracks
# PRISM_STRATUM_HIGHDIFF_START_DIFF and must stay within [MIN_DIFF, MAX_DIFF].
PRISM_STRATUM_HIGHDIFF_SHARE_DIFF=
# Below this many distinct accepted miners, jobs run in collection mode and a
# solved block settles solver-pays-all through its signed bootstrap manifest.
PRISM_MIN_READY_MINERS=3
# Empty means testnet/signet chains use the built-in tq fallback address, while
# regtest and mainnet keep invalid usernames fail-closed unless explicitly set.
PRISM_USERNAME_FALLBACK_ADDRESS=
# Fixed absolute miner payout floor. Empty uses the formula inputs below.
PRISM_PAYOUT_MIN_OUTPUT_SATS=
PRISM_PAYOUT_P2MR_SPEND_INPUT_BYTES=3680
PRISM_PAYOUT_TARGET_FEERATE_SATS_PER_BYTE=1
PRISM_PAYOUT_SAFETY_MULTIPLIER=4
PRISM_CTV_SETTLEMENT_ENABLED=0
PRISM_CTV_FANOUT_FEE_MARKET_RATE_BITS_PER_1000_WEIGHT=
PRISM_CTV_FANOUT_FEE_PREMIUM_BPS=12000
PRISM_CTV_FANOUT_FEE_ESTIMATE_TARGET_BLOCKS=2
PRISM_CTV_BROADCASTER_ENABLED=
PRISM_CTV_BROADCASTER_WALLET=
PRISM_CTV_BROADCASTER_FEE_BITS=0
PRISM_CTV_BROADCASTER_LIMIT=100
PRISM_CTV_BROADCASTER_CHUNK_SIZE=5
PRISM_CTV_BROADCASTER_INTERVAL_SECONDS=30
PRISM_POOL_FEE_ENABLED=0
PRISM_POOL_FEE_BPS=
# Configure either a qbit P2MR fee address or a raw 32-byte P2MR program.
PRISM_POOL_FEE_ADDRESS=
PRISM_POOL_FEE_P2MR_PROGRAM_HEX=
PRISM_POOL_FEE_RECIPIENT_ID=
PRISM_POOL_FEE_ORDER_KEY=
# Coinbase output ordering: canonical (compatibility default) or pool-fee-first.
# pool-fee-first requires an enabled pool fee, keeps the fee out of CTV fanout,
# and emits a positive fee output at coinbase vout 0.
PRISM_COINBASE_OUTPUT_POLICY=canonical
PRISM_POSTGRES_IMAGE=postgres:16-alpine
PRISM_POSTGRES_DB=qbit
PRISM_POSTGRES_USER=qbit
PRISM_POSTGRES_PASSWORD=change-this
PRISM_DATABASE_URL=postgresql://qbit:change-this@prism-postgres:5432/qbit
PRISM_POSTGRES_PSQL_COMMAND=
PRISM_POSTGRES_INIT_SCHEMA=1
PRISM_POSTGRES_READ_CONCURRENCY=4
# How long the server lets a coordinator session sit idle inside an open
# transaction before aborting it and releasing its locks. Bounds how long a
# vanished client (partition, SIGSTOP, VM pause) can strand the writer-lease
# row lock and block a successor's startup.
PRISM_POSTGRES_IDLE_IN_TRANSACTION_TIMEOUT_SECONDS=15
# Server-side TCP keepalives toward coordinator sessions, the backstop for
# backends the idle-in-transaction timer cannot cover. On a TCP connection
# whose platform implements them, the defaults bound dead-socket detection at
# idle + count x interval = 30 + 3x10 = 60s instead of the OS default of
# roughly two hours; Unix-socket DSNs ignore them.
PRISM_POSTGRES_TCP_KEEPALIVES_IDLE_SECONDS=30
PRISM_POSTGRES_TCP_KEEPALIVES_INTERVAL_SECONDS=10
PRISM_POSTGRES_TCP_KEEPALIVES_COUNT=3
# How long the coordinator reuses one pool-wide PRISM reward-window aggregate
# across public miner-page requests before re-running the recursive window
# scan; 0 recomputes on every request.
# Read by the ledger, so prism-coordinator and prism-public-api both set it.
# It is also the one cache stacked under another on the public surface, which
# is why /public/v1/miners/{recipient_id} carries a larger staleness budget
# (105s) than the other plain row reads (15s).
PRISM_PUBLIC_REWARD_WINDOW_CACHE_SECONDS=30
PRISM_SHARE_COMMIT_BATCH_SIZE=64
PRISM_SHARE_COMMIT_LINGER_MILLISECONDS=5
PRISM_SHARE_COMMIT_TIMEOUT_SECONDS=15
PRISM_TEMPLATE_REFRESH_FAILURE_EXIT_SECONDS=120
PRISM_COORDINATION_BLOCKED_EXIT_SECONDS=900
# How long an own-hash tip observation keeps protecting a submitted block
# candidate from terminal abandonment while instantaneous chain probes
# disagree (lost submitblock acks, transient fork views).
PRISM_OBSERVED_TIP_ACCEPT_WINDOW_SECONDS=300
PRISM_HEALTH_PENDING_REFRESH_MAX_AGE_SECONDS=15
PRISM_HEALTH_TIP_POLL_MAX_AGE_SECONDS=15
PRISM_LEDGER_WRITER_ID=prism-coordinator
PRISM_LEDGER_WRITER_EPOCH=1
PRISM_LEDGER_WRITER_SESSION_TOKEN=
PRISM_LEDGER_WRITER_PUBLIC_KEY_HEX=
PRISM_LEDGER_LEASE_TTL_SECONDS=60
# Per-attempt lock/statement deadline and attempt budget for the startup
# writer-lease acquisition. Attempts x deadline (5x5s = 25s) is sized to
# outlast PRISM_POSTGRES_IDLE_IN_TRANSACTION_TIMEOUT_SECONDS, so an orphaned
# lock is normally reaped mid-budget and startup self-heals; an acquisition
# that never completes within the budget exits the coordinator visibly
# instead of blocking for hours.
PRISM_LEDGER_LEASE_ACQUIRE_LOCK_TIMEOUT_SECONDS=5
PRISM_LEDGER_LEASE_ACQUIRE_ATTEMPTS=5
# Bounds durable writer flushing before shutdown leaves the lease to its TTL.
PRISM_WRITER_QUIESCENCE_TIMEOUT_SECONDS=15
PRISM_MANIFEST_SIGNING_SEED_HEX=
PRISM_LEDGER_ATTESTATION_SIGNING_SEED_HEX=
PRISM_ALLOW_MEMORY_LEDGER=0
PRISM_ALLOW_TEST_SIGNING_SEEDS=0
PRISM_ALLOW_BUNDLE_EMBEDDED_LEDGER_KEY=0
PRISM_ALLOW_FIXED_LEDGER_SESSION_TOKEN=0

# Signet overrides:
# QBIT_CHAIN=signet
# QBIT_CHAIN_FLAG=-signet
# QBIT_NODE_EXTRA_ARG=-signetchallenge=<your_signet_challenge_hex>
# QBIT_LISTEN=0
# QBIT_RPC_PORT=38352
# QBIT_P2P_PORT=38355
# QBIT_RPC_PORT_HOST=127.0.0.1:38352
# QBIT_P2P_PORT_HOST=127.0.0.1:38355
# QBIT_MINER_ADDRESS=auto
# CKPOOL_MINDIFF=<reviewed-share-floor>
# CKPOOL_STARTDIFF=<reviewed-starting-share-difficulty>
# CKPOOL_MAXDIFF=<optional-share-difficulty-cap>
#
# qbitd stays private by default. To intentionally run a reachable qbit peer,
# set QBIT_LISTEN=1 and publish QBIT_P2P_PORT_HOST=0.0.0.0:<p2p-port>.
#
# Optional live parent-chain overrides for AuxPoW operator mode:
# BITCOIN_RPC_HOST=<your_parent_node_host>
# BITCOIN_RPC_PORT=<your_parent_node_rpc_port>
# BITCOIN_RPC_USER=<your_parent_node_rpc_user>
# BITCOIN_RPC_PASSWORD=<your_parent_node_rpc_password>
# BITCOIN_MINER_ADDRESS=<your_bitcoin_payout_address>
#
# Local Bitcoin testnet4 parent-node example:
# BITCOIN_CHAIN_FLAG=-testnet4
# BITCOIN_RPC_PORT=48332
# BITCOIN_P2P_PORT=48333
# BITCOIN_RPC_PORT_HOST=127.0.0.1:48332
# BITCOIN_P2P_PORT_HOST=127.0.0.1:48333
# BITCOIN_DNSSEED=1
# BITCOIN_DISCOVER=0
# BITCOIN_NODE_EXTRA_ARGS=
# BITCOIN_MINER_ADDRESS=<your_bitcoin_testnet4_payout_address>
#
# Equivalent discovery override using the general extra-args hook:
# BITCOIN_NODE_EXTRA_ARGS="-dnsseed=1"
